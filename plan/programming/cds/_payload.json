5,"props":353,"children":355},{"className":354},[],[356],{"type":42,"value":357},"~/.cds_config.json",{"type":42,"value":359}," 中的脚本命令",{"type":22,"tag":315,"props":361,"children":363},{"className":362},[318],[364,367,369,375,377],{"type":22,"tag":321,"props":365,"children":366},{"checked":255,"disabled":255,"type":323},[],{"type":42,"value":368}," 3. Auto: 可以自动记录，例如 ",{"type":22,"tag":45,"props":370,"children":372},{"className":371},[],[373],{"type":42,"value":374},"/Users/uwu/Code/My/iusx",{"type":42,"value":376}," 的时候自动记录 ",{"type":22,"tag":45,"props":378,"children":380},{"className":379},[],[381],{"type":42,"value":382},"iusx: /Users/uwu/Code/My/iusx",{"type":22,"tag":38,"props":384,"children":385},{},[386,388,394],{"type":42,"value":387},"要做到上述功能需要配合 shell 环境，不过在此之前我希望将 TODO 2~3 完成后打包到 Homebrew，这样就可以通过 ",{"type":22,"tag":45,"props":389,"children":391},{"className":390},[],[392],{"type":42,"value":393},"brew install cds",{"type":42,"value":395}," 来进行安装了（貌似应该写一个安装脚本？。",{"type":22,"tag":38,"props":397,"children":398},{},[399,401,408],{"type":42,"value":400},"其实依赖 shell 环境也没什么的，毕竟连 Nim-lang 的 ",{"type":22,"tag":122,"props":402,"children":405},{"href":403,"rel":404},"https://github.com/nim-lang/choosenim",[126],[406],{"type":42,"value":407},"choosenim",{"type":42,"value":409}," 在安装完后也需要手动设置不是吗？",{"type":22,"tag":167,"props":411,"children":413},{"className":169,"code":412,"language":42,"meta":7,"style":7},"choosenim-init: ChooseNim installed in /Users/uwu/.nimble/bin\nchoosenim-init: You must now ensure that the Nimble bin dir is in your PATH.\nchoosenim-init: Place the following line in the ~/.profile or ~/.bashrc file.\nchoosenim-init:     export PATH=/Users/uwu/.nimble/bin:$PATH\n",[414],{"type":22,"tag":45,"props":415,"children":416},{"__ignoreMap":7},[417,425,433,441],{"type":22,"tag":176,"props":418,"children":419},{"class":178,"line":179},[420],{"type":22,"tag":176,"props":421,"children":422},{},[423],{"type":42,"value":424},"choosenim-init: ChooseNim installed in /Users/uwu/.nimble/bin\n",{"type":22,"tag":176,"props":426,"children":427},{"class":178,"line":188},[428],{"type":22,"tag":176,"props":429,"children":430},{},[431],{"type":42,"value":432},"choosenim-init: You must now ensure that the Nimble bin dir is in your PATH.\n",{"type":22,"tag":176,"props":434,"children":435},{"class":178,"line":197},[436],{"type":22,"tag":176,"props":437,"children":438},{},[439],{"type":42,"value":440},"choosenim-init: Place the following line in the ~/.profile or ~/.bashrc file.\n",{"type":22,"tag":176,"props":442,"children":443},{"class":178,"line":206},[444],{"type":22,"tag":176,"props":445,"children":446},{},[447],{"type":42,"value":448},"choosenim-init:     export PATH=/Users/uwu/.nimble/bin:$PATH\n",{"type":22,"tag":38,"props":450,"children":451},{},[452],{"type":42,"value":453},"有时候就是这样，只有自己亲身体验才能体会一些奇妙的感觉。也就是踩坑，而不是照着答案去答题。最近看的 《心灵捕手》和 《萨利机长》刚好有这个情景，印象深刻的是《心灵捕手》中的一段对话：",{"type":22,"tag":455,"props":456,"children":459},"wise-info",{"by":457,"topic":458},"心灵捕手","知识与体验的区别",[460,465,474,479,484,489,494,499],{"type":22,"tag":38,"props":461,"children":462},{},[463],{"type":42,"value":464},"You've never been out of Boston.",{"type":22,"tag":466,"props":467,"children":468},"blockquote",{},[469],{"type":22,"tag":38,"props":470,"children":471},{},[472],{"type":42,"value":473},"Nope",{"type":22,"tag":38,"props":475,"children":476},{},[477],{"type":42,"value":478},"So if l asked you about art, you'd probably give me..\nthe skinny on every art book ever written",{"type":22,"tag":38,"props":480,"children":481},{},[482],{"type":42,"value":483},"Michelangelo. You kno a lot about him.\nLife's work. Political aspirations. Him and the pope.",{"type":22,"tag":38,"props":485,"children":486},{},[487],{"type":42,"value":488},"Sexual orientation. the whole works, right?",{"type":22,"tag":38,"props":490,"children":491},{},[492],{"type":42,"value":493},"I bet you can't tell me what it smells like\nin the Sistione Chapel",{"type":22,"tag":38,"props":495,"c