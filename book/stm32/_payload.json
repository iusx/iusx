Flash、NAND Flash、LCD 屏），扩展存储和显示能力。",{"type":17,"tag":75,"props":758,"children":759},{},[760,768,773],{"type":17,"tag":97,"props":761,"children":762},{},[763],{"type":17,"tag":280,"props":764,"children":765},{},[766],{"type":38,"value":767},"USB OTG",{"type":17,"tag":97,"props":769,"children":770},{},[771],{"type":38,"value":772},"USB主机接口",{"type":17,"tag":97,"props":774,"children":775},{},[776],{"type":38,"value":777},"USB On-The-Go 控制器，支持 USB 主机、设备、OTG 模式（部分高性能 STM32 才有）。",{"title":7,"searchDepth":779,"depth":779,"links":780},2,[781],{"id":240,"depth":779,"text":243},"markdown","content:book:stm32.md","content","book/stm32.md","md",{"loc":788},"https://m.ritsu.jiangxue.org/book/stm32",{"script":790,"meta":798},[791],{"id":792,"type":793,"processTemplateParams":794,"innerHTML":795,"tagPosition":796,"tagPriority":797},"nuxt-og-image-overrides","application/json",true,"[{\"title\":1,\"excerpt\":-1,\"component\":2},\"STM32\",\"OgImageCustom\"]","bodyClose",30,[799,802,805,808,811,813,816,818,820,822],{"property":800,"content":801},"og:image","/__og-image__/static/book/stm32/og.png",{"property":803,"content":804},"og:image:width",1200,{"property":806,"content":807},"og:image:height",600,{"property":809,"content":810},"og:image:type","image/png",{"property":812},"og:image:alt",{"name":814,"content":815},"twitter:card","summary_large_image",{"name":817,"content":801},"twitter:image:src",{"name":819,"content":804},"twitter:image:width",{"name":821,"content":807},"twitter:image:height",{"name":823},"twitter:image:alt",1793977989821]