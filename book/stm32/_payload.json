n":460},{},[461],{"type":38,"value":462},"外设与内存之间高速数据搬运（无需 CPU 参与），极大减轻 CPU 负担，常用在 ADC、SPI、USART 等高速传输场景。",{"type":17,"tag":75,"props":464,"children":465},{},[466,474,479],{"type":17,"tag":97,"props":467,"children":468},{},[469],{"type":17,"tag":280,"props":470,"children":471},{},[472],{"type":38,"value":473},"USART",{"type":17,"tag":97,"props":475,"children":476},{},[477],{"type":38,"value":478},"同步/异步串口通信",{"type":17,"tag":97,"props":480,"children":481},{},[482],{"type":38,"value":483},"通用同步异步收发器（UART/USART），用于串口通信（如调试打印、GPS、蓝牙模块）。",{"type":17,"tag":75,"props":485,"children":486},{},[487,495,500],{"type":17,"tag":97,"props":488,"children":489},{},[490],{"type":17,"tag":280,"props":491,"children":492},{},[493],{"type":38,"value":494},"I2C",{"type":17,"tag":97,"props":496,"children":497},{},[498],{"type":38,"value":499},"I2C通信",{"type":17,"tag":97,"props":501,"children":502},{},[503],{"type":38,"value":504},"两线制串行总线（SDA+SCL），用于连接传感器、EEPROM、OLED 等，支持多设备挂载。",{"type":17,"tag":75,"props":506,"children":507},{},[508,516,521],{"type":17,"tag":97,"props":509,"children":510},{},[511],{"type":17,"tag":280,"props":512,"children":513},{},[514],{"type":38,"value":515},"SPI",{"type":17,"tag":97,"props":517,"children":518},{},[519],{"type":38,"value":520},"SPI通信",{"type":17,"tag":97,"props":522,"children":523},{},[524],{"type":38,"value":525},"高速同步串行外围接口（全双工），常用于 Flash、LCD、SD 卡、传感器等高速通信。",{"type":17,"tag":75,"props":527,"children":528},{},[529,537,542],{"type":17,"tag":97,"props":530,"children":531},{},[532],{"type":17,"tag":280,"props":533,"children":534},{},[535],{"type":38,"value":536},"CAN",{"type":17,"tag":97,"props":538,"children":539},{},[540],{"type":38,"value":541},"CAN通信",{"type":17,"tag":97,"props":543,"children":544},{},[545],{"type":38,"value":546},"控制器局域网总线，工业/汽车领域标准总线，支持多机通信、抗干扰能力强。",{"type":17,"tag":75,"props":548,"children":549},{},[550,558,563],{"type":17,"tag":97,"props":551,"children":552},{},[553],{"type":17,"tag":280,"props":554,"children":555},{},[556],{"type":38,"value":557},"USB",{"type":17,"tag":97,"props":559,"children":560},{},[561],{"type":38,"value":562},"USB通信",{"type":17,"tag":97,"props":564,"children":565},{},[566],{"type":38,"value":567},"USB 设备控制器，支持 USB 全速设备模式（如虚拟串口、HID、MSC）。",{"type":17,"tag":75,"props":569,"children":570},{},[571,579,584],{"type":17,"tag":97,"props":572,"children":573},{},[574],{"type":17,"tag":280,"props":575,"children":576},{},[577],{"type":38,"value":578},"RTC",{"type":17,"tag":97,"props":580,"children":581},{},[582],{"type":38,"value":583},"实时时钟",{"type":17,"tag":97,"props":585,"children":586},{},[587],{"type":38,"value":588},"独立实时时钟模块，可在主电源关闭时（VBAT 供电）继续计时日期和时间。",{"type":17,"tag":75,"props":590,"children":591},{},[592,600,605],{"type":17,"tag":97,"props":593,"children":594},{},[595],{"type":17,"tag":280,"props":596,"children":597},{},[598],{"type":38,"value":599},"CRC",{"type":17,"tag":97,"props":601,"children":602},{},[603],{"type":38,"value":604},"CRC校验",{"type":17,"tag":97,"props":606,"children":607},{},[608],{"type":38,"value":609},"硬件循环冗余校验单元，快速计算数据包的 CRC 校验码，提升通信可靠性。",{"type":17,"tag":75,"props":611,"children":612},{},[613,621,626],{"type":17,"tag":97,"props":614,"children":615},{},[616],{"type":17,"tag":280,"props":617,"children":618},{},[619],{"type":38,"value":620},"PWR",{"type":17,"tag":97,"props":622,"children":623},{},[624],{"type":38,"value":625},"电源控制",{"type":17,"tag":97,"props":627,"children":628},{},[629],{"type":38,"value":630},"管理芯片各种低功耗模式（睡眠、停机、待机），以及电源电压监测（PVD）。",{"type":17,"tag":75,"props":632,"children":633},{},[634,642,647],{"type":17,"tag":97,"props":635,"children":636},{},[637],{"type":17,"tag":280,"props":638,"children":639},{},[640],{"type":38,"value":641},"BKP",{"type":17,"tag":97,"props":643,"children":644},{},[645],{"type":38,"value":646},"备份寄存器",{"type":17,"tag":97,"props":648,"children":649},{},[650],{"type":38,"value":651},"位于备份域的少量寄存器，在 VBAT 供电下数据不丢失，常用于保存关键参数。",{"type":17,"tag":75,"props":653,"children":654},{},[655,663,668],{"type":17,"tag":97,"