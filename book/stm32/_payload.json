[{"data":1,"prerenderedAt":824},["Reactive",2],{"page-document:/book/stm32":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":782,"_id":783,"_source":784,"_file":785,"_extension":786,"sitemap":787,"head":789},"/book/stm32","book",false,"","STM32","My","2026.05.15","stm32/1.png","100,100",{"type":14,"children":15,"toc":778},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,30,40,51,56,61,149,154,156,237,244,246],{"type":17,"tag":26,"props":27,"children":29},"text-title",{":t":28},"为什么想学 STM32",[],{"type":17,"tag":31,"props":32,"children":36},"h1",{"id":33,"data-toc-marker":34,"data-toc-count":35,"aria-hidden":34},"为什么学-stm32-1","true","1",[37],{"type":38,"value":39},"text","为什么学 STM32 1",{"type":17,"tag":41,"props":42,"children":44},"text-space",{"type":43},"tip",[45],{"type":17,"tag":46,"props":47,"children":48},"p",{},[49],{"type":38,"value":50},"现在我才知道那种包着硬件的灰色透明塑胶袋，实际上叫 ESD静电保护袋抗静电袋（Electrostatic Discharge Bag，简称 ESD Bag）是一种专门设计用来防止静电累积与静电放电的包装材料，主要应用于电子元件、半导体、PCB、感测器、精密零组件等对静电敏感的产品。",{"type":17,"tag":46,"props":52,"children":53},{},[54],{"type":38,"value":55},"在此之前我完全不知道 STM32 是什么，只是在 X 上刷到了很多硬件的分享帖子。同时感觉只会写软件太局限了，接触点硬件也很不错。于是在朋友的推荐下买了 STM32。在购买的时候遇到了一个有趣的事情，由于我是在咸鱼买的二手 STM32 套件，刚好是江协的，价格刚好是 32, 拿到货之后很新，就拆了几个，但 STM32 没有拆，还是那个灰色的透明塑封包着的。",{"type":17,"tag":46,"props":57,"children":58},{},[59],{"type":38,"value":60},"而且这个包装特别自信，二维码就是 STM32 入门套件，一扫就跳到 bing，第一个就是江协的 CSDN，然后官网直接跳转到视频，视频课程还有百度网盘的下载链接（很 low，为什么不做成在线的文档，一种很老的气息扑面而来）而且还有 2475.4万 的播放量。这说明这个行业很卷，很多人。",{"type":17,"tag":41,"props":62,"children":63},{"type":43},[64,66],{"type":38,"value":65},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":17,"tag":67,"props":68,"children":69},"table",{},[70,89],{"type":17,"tag":71,"props":72,"children":73},"thead",{},[74],{"type":17,"tag":75,"props":76,"children":77},