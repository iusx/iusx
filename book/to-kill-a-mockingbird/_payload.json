[{"data":1,"prerenderedAt":278},["Reactive",2],{"content-query-QsLvtFYArv":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":238,"_id":239,"_source":240,"_file":241,"_extension":242,"head":243},"/book/to-kill-a-mockingbird","book",false,"","杀死一只知更鸟","Nelle Harper Lee","2026","to-kill-a-mockingbird/1.jpg","100,100",{"type":14,"children":15,"toc":235},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,29,36,42,61,84,101,118,123,205],{"type":17,"tag":26,"props":27,"children":28},"text-title",{"t":8},[],{"type":17,"tag":30,"props":31,"children":32},"p",{},[33],{"type":34,"value":35},"text","我发现最近一两年我几乎很少看书，更多时间都是在看电影，电视剧甚至是刷视频。虽然买了 B 站的年度大会员和夸克网盘的会员，但我意识到真正能给我带来收获的更多是 telegram 和 x.com。前者能看一些小道消息，而后者能每天给我推我感兴趣的。而不是 b 站那种垃圾算法和推广一些我不感兴趣充斥着广告推广的视频。因此我捡起了很久没有打开和下载的微信读书，有一说一微信读书真的算是活菩萨，会员几乎貌似只要连续每天看书就会一直送的样子。",{"type":17,"tag":26,"props":37,"children":41},{"t":38,"id":39,"type":40},"第一章","第一章-3","2",[],{"type":17,"tag":43,"props":44,"children":46},"wise-info",{"by":45,"topic":8},"拧发条鸟",[47,52],{"type":17,"tag":30,"props":48,"children":49},{},[50],{"type":34,"value":51},"母亲在我两岁时就去世了，所以我从来没有痛失母爱的感觉。",{"type":17,"tag":53,"props":54,"children":55},"blockquote",{},[56],{"type":17,"tag":30,"props":57,"children":58},{},[59],{"type":34,"value":60},"因为痛失的前提是拥有",{"type":17,"tag":43,"props":62,"children":64},{"by":63,"topic":8},"九九 / raye",[65,70],{"type":17,"tag":30,"props":66,"children":67},{},[68],{"type":34,"value":69},"那些胡桃散落在地上，孩子们谁也不敢去碰，因为拉德利家的胡桃吃了会死人的",{"type":17,"tag":53,"props":71,"children":72},{},[73],{"type":17,"tag":30,"props":74,"children":75},{},[76,78,82],{"type":34,"value":77},"流言一旦散布，便埋下怀疑的种子，有时候最伤人的不是真相，而是无端的猜忌和漠视",{"type":17,"tag":79,"props":80,"children":81},"br",{},[],{"type":34,"value":83},"\n偏见让科学变成迷信，让理性变得空白，让谎言变成真相",{"type":17,"tag":43,"props":85,"children":87},{"by":86,"topic":8},"Dove",[88,93],{"type":17,"tag":30,"props":89,"children":90},{},[91],{"type":34,"value":92},"没人知道拉德利先生用了什么恐吓手段，让怪人从不露面。杰姆的猜测是，拉德利先生大部分时间用锁链把他拴在床上。阿迪克斯说不对，不是这么回事儿，要把一个人变成幽灵有的是办法。",{"type":17,"tag":53,"props":94,"children":95},{},[96],{"type":17,"tag":30,"props":97,"children":98},{},[99],{"type":34,"value":100},"摧毁一个人最简单的办法便是：杀死他的意志，锁住他的手脚，身体精神双重扼杀",{"type":17,"tag":43,"props":102,"children":104},{"by":103,"topic":8},"春夏",[105,110],{"type":17,"tag":30,"props":106,"children":107},{},[108],{"type":34,"value":109},"把上帝的话语当作自己的唯一准则。我们对她的话深信不疑，因为拉德利先生的姿势一贯是笔管条直的。",{"type":17,"tag":53,"props":111,"children":112},{},[113],{"type":17,"tag":30,"props":114,"children":115},{},[116],{"type":34,"value":117},"偏执的人，习惯用道德准则拿起自己所谓正义的剑，却不知，该斩的是自己的蒙昧和愚蠢。",{"type":17,"tag":30,"props":119,"children":120},{},[121],{"type":34,"value":122},"看到这的时候回想起来了鲍鹏山所说的 “充满正义感的理想主义者极其愚昧。” 以前我会感觉这句话非常新颖，而读了这本书之后发现自己只是看的书少了而已。",{"type":17,"tag":43,"props":124,"children":127},{"by":125,"topic":126},"鲍鹏山","充满正义感的理想主义者极其愚昧。",[128,146,159,177,190,200],{"type":17,"tag":30,"props":129,"children":130},{},[131,133,136,138,141,143],{"type":34,"value":132},"这个世界上最可怕的人，不是心里知道自己是坏人的人。",{"type":17,"tag":79,"props":134,"children":135},{},[],{"type":34,"value":137},"\n因为他知道自己是坏人",{"type":17,"tag":79,"props":139,"children":140},{},[],{"type":34,"value":142},"\n他知道自己做坏事，总会恐惧、总会有点内疚。",{"type":17,"tag":79,"props":144,"children":145},{},[],{"type":17,"tag":30,"props":147,"children":148},{},[149,151,154,156],{"type":34,"value":150},"什么样的人把坏事做的堂堂正正",{"type":17,"tag":79,"props":152,"children":153},{},[],{"type":34,"value":155},"\n做的义愤填膺、做的慷慨激昂呢？",{"type":17,"tag":79,"props":157,"children":158},{},[],{"type":17,"tag":30,"props":160,"children":161},{},[162,164,167,169,172,174],{"type":34,"value":163},"是自以为自己做好事的人。",{"type":17,"tag":79,"props":165,"children":166},{},[],{"type":34,"value":168},"\n冲着一个伟大的理想去做事，",{"type":17,"tag":79,"props":170,"children":171},{},[],{"type":34,"value":173},"\n但事实是他搞错了。",{"type":17,"tag":79,"props":175,"children":176},{},[],{"type":17,"tag":30,"props":178,"children":179},{},[180,182,185,187],{"type":34,"value":181},"但是他心目中又觉得自己做好事、做一个伟大的理想。",{"type":17,"tag":79,"props":183,"children":184},{},[],{"type":34,"value":186},"\n所以他一定会把他做的还坏事，做的慷慨激昂、做的一往无前、做的义无反顾。",{"type":17,"tag":79,"props":188,"children":189},{},[],{"type":17,"tag":30,"props":191,"children":192},{},[193,195,198],{"type":34,"value":194},"这个世界上给人类造成最大灾难的。",{"type":17,"tag":79,"props":196,"children":197},{},[],{"type":34,"value":199},"\n都不是认识到自己是坏人的人。",{"type":17,"tag":30,"props":201,"children":202},{},[203],{"type":34,"value":204},"而恰恰是那些充满正义感的理想主义者。",{"type":17,"tag":43,"props":206,"children":208},{"by":207,"topic":8},"KXLYH / 水水",[209,214,222,227],{"type":17,"tag":30,"props":210,"children":211},{},[212],{"type":34,"value":213},"我觉得他热爱荣誉胜过自己的脑袋，因为迪尔轻而易举就把他搞定了。",{"type":17,"tag":53,"props":215,"children":216},{},[217],{"type":17,"tag":30,"props":218,"children":219},{},[220],{"type":34,"value":221},"人生是用来体验的，不是用来演绎完美的",{"type":17,"tag":30,"props":223,"children":224},{},[225],{"type":34,"value":226},"第一天，迪尔对他说：“你害怕了。”“我不害怕，只是不想冒犯别人。”杰姆反驳道。第二天迪尔又说：“你是个胆小鬼，都不敢把脚踏进前院。”杰姆说这完全是胡说八道，他上学的时候每天都从拉德利家门前经过。",{"type":17,"tag":53,"props":228,"children":229},{},[230],{"type":17,"tag":30,"props":231,"children":232},{},[233],{"type":34,"value":234},"只要你还在乎你的面子，在乎外界对你的评价，那么激将法对你作用永远都存在。",{"title":7,"searchDepth":236,"depth":236,"links":237},2,[],"markdown","content:book:to-kill-a-mockingbird.md","content","book/to-kill-a-mockingbird.md","md",{"script":244,"meta":252},[245],{"id":246,"type":247,"processTemplateParams":248,"innerHTML":249,"tagPosition":250,"tagPriority":251},"nuxt-og-image-overrides","application/json",true,"[{\"title\":1,\"excerpt\":-1,\"component\":2},\"杀死一只知更鸟\",\"OgImageCustom\"]","bodyClose",30,[253,256,259,262,265,267,270,272,274,276],{"property":254,"content":255},"og:image","/__og-image__/static/book/to-kill-a-mockingbird/og.png",{"property":257,"content":258},"og:image:width",1200,{"property":260,"content":261},"og:image:height",600,{"property":263,"content":264},"og:image:type","image/png",{"property":266},"og:image:alt",{"name":268,"content":269},"twitter:card","summary_large_image",{"name":271,"content":255},"twitter:image:src",{"name":273,"content":258},"twitter:image:width",{"name":275,"content":261},"twitter:image:height",{"name":277},"twitter:image:alt",1791962130792]