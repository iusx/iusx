[{"data":1,"prerenderedAt":217},["Reactive",2],{"page-document:/book/gimp":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":175,"_id":176,"_source":177,"_file":178,"_extension":179,"sitemap":180,"head":182},"/book/gimp","book",false,"","Gimp","My","2025","gimp/1.png","100,100",{"type":14,"children":15,"toc":172},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,48,53,58,66,71,76,80,89,93,133,156,161,167],{"type":17,"tag":26,"props":27,"children":29},"text-space",{"type":28},"tip",[30],{"type":17,"tag":31,"props":32,"children":33},"p",{},[34,37,46],{"type":35,"value":36},"text","哈哈，写完并且过了很久之后我在 STEAM 上买游戏的时候看到了 Krita。虽然知道他是开源的，但是我还是在 STEAM 上花了钱购买了他。有一说一 Gimp 有点像 Adobe Illustrator + Photoshop 的结合体，而 krita 则类似 ",{"type":17,"tag":38,"props":39,"children":43},"a",{"href":40,"rel":41},"https://www.systemax.jp/en/sai/",[42],"nofollow",[44],{"type":35,"value":45},"sai",{"type":35,"value":47}," + ps",{"type":17,"tag":49,"props":50,"children":52},"text-title",{":t":51},"为什么开始用 Gimp",[],{"type":17,"tag":31,"props":54,"children":55},{},[56],{"type":35,"value":57},"随着 Adobe Photoshop 不断在联网上增加了很多限制，例如必须用 Adobe Creative Cloud  来进行安装。适用于 macOS 的破解版愈发稀少。虽然能用，但因为 macOS 系统更新的缘故。老版本越来越卡。如果是 Windows 10，我还可以继续用 PS cs6 版本，很轻量。再加上最近版本不断增加在线验证，即使能用，但半小时后、一小时后总会提示盗版弹窗，强制退出。（但断网是可以继续用的，不会弹窗）",{"type":17,"tag":26,"props":59,"children":60},{"type":28},[61],{"type":17,"tag":31,"props":62,"children":63},{},[64],{"type":35,"value":65},"(可能 Adobe 会不断更新服务 API，即使 ban 了一个，几百个，也会继续增加新的",{"type":17,"tag":31,"props":67,"children":68},{},[69],{"type":35,"value":70},"貌似这个弹窗只会针对 PS，单方面的给这个产品上强度，反之 Illustrator 和 After Effects 基本上没怎么弹过。个人还是很少用 Illustrator 的，更多用 Figma 替代他，AE 和 PS 倒是时不时会用上。",{"type":17,"tag":31,"props":72,"children":73},{},[74],{"type":35,"value":75},"一直与 Adobe 这么耗下去也不是办法，经济实力还是消费不起。一个月要 167.51 HKD。毕竟我也不是艺术家，甚至很大一部分程度不是靠设计吃饭的，用 PS 最多的场景就是抠图，拆分、补补拆分后的素材。因此我觉得这种小需求 GIMP 应该能满足我，顺便走出舒适圈，了解下新的环境。确实学到很多没有用的小知识。",{"type":17,"tag":77,"props":78,"children":79},"hr",{},[],{"type":17,"tag":81,"props":82,"children":86},"h1",{"id":83,"data-toc-marker":84,"data-toc-count":85,"aria-hidden":84},"resynthesizer-1","true","1",[87],{"type":35,"value":88},"Resynthesizer 1",{"type":17,"tag":49,"props":90,"children":92},{"t":91},"Resynthesizer",[],{"type":17,"tag":31,"props":94,"children":95},{},[96,98,105,107,114,116,122,124,131],{"type":35,"value":97},"在 PS 中有一个很好用的功能叫 ",{"type":17,"tag":38,"props":99,"children":102},{"href":100,"rel":101},"https://helpx.adobe.com/cn/photoshop/using/content-aware-fill.html",[42],[103],{"type":35,"value":104},"”内容识别填充“",{"type":35,"value":106},"，但在 GIMP 仅提供了 ",{"type":17,"tag":38,"props":108,"children":111},{"href":109,"rel":110},"https://docs.gimp.org/3.0/en/gimp-tool-heal.html",[42],[112],{"type":35,"value":113},"Heal",{"type":35,"value":115}," 有一说一还挺好用的，但是比较花时间？首先比较劝退的是 ",{"type":17,"tag":38,"props":117,"children":120},{"href":118,"rel":119},"https://www.logarithmic.net/pfh/resynthesizer",[42],[121],{"type":35,"value":91},{"type":35,"value":123},"。很难想象这么好的插件自 2004 起就已经发布，至今没有与预装在 GIMP 上。不过让我知道了 ",{"type":17,"tag":38,"props":125,"children":128},{"href":126,"rel":127},"https://ports.macports.org/port/gimp-resynthesizer/details/",[42],[129],{"type":35,"value":130},"macports",{"type":35,"value":132}," 有一说一没 Homebrew 好用。",{"type":17,"tag":31,"props":134,"children":135},{},[136,138,145,147,154],{"type":35,"value":137},"于是我碰到了一个问题，GIMP 最新版本 3.0 无法使用 Resynthesizer，起码在 macOS 上，Windows 上貌似是可以的。于是需要自己编译，自己编译又会遇到 ",{"type":17,"tag":38,"props":139,"children":142},{"href":140,"rel":141},"https://github.com/bootchk/resynthesizer/issues/154",[42],[143],{"type":35,"value":144},"Run-time dependency gimp-3.0 found: NO",{"type":35,"value":146},"、",{"type":17,"tag":38,"props":148,"children":151},{"href":149,"rel":150},"https://github.com/bootchk/resynthesizer/issues/144",[42],[152],{"type":35,"value":153},"Fails to build, problem with i18n (fixed by making default build not generate i18n.) ",{"type":35,"value":155}," 这两个问题。让我体验到了类 Linux 的乐趣。",{"type":17,"tag":31,"props":157,"children":158},{},[159],{"type":35,"value":160},"最终我选择了 GIMP 2.0 版本。但好像比 3.0 卡了许多？没 3.0 那么丝滑了，甚至比 PS 还略微的卡？可能是系统适配的缘故。兜兜转转一个小时已经很快过去，让我感受到了时间的流逝是如此之快。",{"type":17,"tag":162,"props":163,"children":166},"img-tip",{"text":164,"url":165},"图 1 | 有一说一我觉得 PS 的操作是最舒服的，可以选择识别的范围，用绿色的进行涂抹。还是 \u003Cb>可视化的\u003C/b> 最终效果显然也是 PS 的最好,最后一栏是 krita 的那个什么什么工具。处理效果略微接近 PS。但是仔细看还是能看得出来的，比 GIMP 好上很多。但 krita 貌似有很多插件，比如很火的什么 AI 生图很多用的都是 krita。","gimp/test.jpg",[],{"type":17,"tag":31,"props":168,"children":169},{},[170],{"type":35,"value":171},"或许未来有机会可以拿这个点子练练手，基于现在的这个加入类似 PS 的这种交互，应该会学到很多。不过一些复杂的还是会用 PS，一些简单的或许可以尝试下 GIMP，等我解决了这个问题在继续用 GIMP 弄一些复杂的好了。",{"title":7,"searchDepth":173,"depth":173,"links":174},2,[],"markdown","content:book:gimp.md","content","book/gimp.md","md",{"loc":181},"https://m.ritsu.jiangxue.org/book/gimp",{"script":183,"meta":191},[184],{"id":185,"type":186,"processTemplateParams":187,"innerHTML":188,"tagPosition":189,"tagPriority":190},"nuxt-og-image-overrides","application/json",true,"[{\"title\":1,\"excerpt\":-1,\"component\":2},\"Gimp\",\"OgImageCustom\"]","bodyClose",30,[192,195,198,201,204,206,209,211,213,215],{"property":193,"content":194},"og:image","/__og-image__/static/book/gimp/og.png",{"property":196,"content":197},"og:image:width",1200,{"property":199,"content":200},"og:image:height",600,{"property":202,"content":203},"og:image:type","image/png",{"property":205},"og:image:alt",{"name":207,"content":208},"twitter:card","summary_large_image",{"name":210,"content":194},"twitter:image:src",{"name":212,"content":197},"twitter:image:width",{"name":214,"content":200},"twitter:image:height",{"name":216},"twitter:image:alt",1792744857406]