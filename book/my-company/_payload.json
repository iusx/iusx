[{"data":1,"prerenderedAt":703},["Reactive",2],{"page-document:/book/my-company":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":661,"_id":662,"_source":663,"_file":664,"_extension":665,"sitemap":666,"head":668},"/book/my-company","book",false,"","我创建的第一家公司","My","2026","my-company/1.png","1,100",{"type":14,"children":15,"toc":652},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,33,39,52,57,62,67,73,78,83,92,100,126,383,388,393,398,403,409,437,481,483,559,580,585,591,635,647],{"type":17,"tag":26,"props":27,"children":29},"h1",{"id":28},"my-dream",[30],{"type":31,"value":32},"text","My dream",{"type":17,"tag":34,"props":35,"children":36},"p",{},[37],{"type":31,"value":38},"以前上小学和初中的时候一直想着创业，名字当初都想好了分别是 “芈极创新” ，和负责安全的 “江雪分析”。依稀记得当时是 2018 年,也不知道当初是怎么想的，几年过后我跟他们都闹掰了淡淡的忘了联系。",{"type":17,"tag":34,"props":40,"children":41},{},[42,44,50],{"type":31,"value":43},"当时觉得如果有一家公司会很帅，因为可以申请微信公众号以及微博的 ",{"type":17,"tag":45,"props":46,"children":47},"strong",{},[48],{"type":31,"value":49},"V",{"type":31,"value":51}," 认证。八年过后我成功注册了一家公司，并没有想象中的那么难也没有那么简单。我将公司选择在了深圳市，毕竟是大城市，也是我从小长大的地方。毕竟以后出门说公司是深圳市的，比什么其他城市的会听起来高级一点。",{"type":17,"tag":34,"props":53,"children":54},{},[55],{"type":31,"value":56},"也是时候到了，朋友找我开发东西每次都是他自己垫付自掏腰包。而我还嫌弃每次都是几十几百块的磨磨叽叽要求多，但终于某一天他跟我透露心声不如让我去注册公司，开一个对公账户，这样每次就可以有发票找领导报销了。",{"type":17,"tag":34,"props":58,"children":59},{},[60],{"type":31,"value":61},"于是我也就冲动消费注册了公司。现在想真的是误入了一个深坑里，什么地方都要钱。但我建议有玉玉症的可以注册公司体验一下被人需要的感觉。",{"type":17,"tag":34,"props":63,"children":64},{},[65],{"type":31,"value":66},"当公司注册的那一刹那，慕名而来的推销电话可以接到手软，而且都会以 x 总称呼，非常能满足虚荣心。比掏大几万去看心理医生还没有用，投入到公司里面起码还有资产，知识产权什么的。",{"type":17,"tag":68,"props":69,"children":71},"h2",{"id":70},"注册",[72],{"type":31,"value":70},{"type":17,"tag":34,"props":74,"children":75},{},[76],{"type":31,"value":77},"其实注册公司一直是免费的，在这一段经历中我也踩了很多坑。我找了朋友问问他们是怎么注册公司的，全部都统一口径说淘宝代办的。于是我就在淘宝找了一个看起来还行，但店铺设计看起来是椰树风格的代办公司。宣传海报上写的很厉害，但实际一查就会发现貌似很多都是外包出去的。",{"type":17,"tag":34,"props":79,"children":80},{},[81],{"type":31,"value":82},"例如注册地址太 low，而不是我想要的什么创业园，科技园，工业园之类的，而是一个百货大楼。但谁让代办公司给的价格便宜呢（貌似到物业公司手上才 400）。地址费用一年是 1800,报税什么的是 1200。",{"type":17,"tag":84,"props":85,"children":86},"blockquote",{},[87],{"type":17,"tag":34,"props":88,"children":89},{},[90],{"type":31,"value":91},"龙岗小规模公司 挂靠真实地址 挂靠费用1800/年，赠送注册+ 章\n挂靠地址有管家服务，可开对公账户，可代收信函快递，可配合工商税务银行核查",{"type":17,"tag":84,"props":93,"children":94},{},[95],{"type":17,"tag":34,"props":96,"children":97},{},[98],{"type":31,"value":99},"小规模 不开票记账报税：1200元/年\n包含税务报道+税种核定+月报季报年报+年度汇算清缴+财务报表+年度工商年报+账本+社保+一对一财税会计对接+财务管理咨询+合理筹划报税",{"type":17,"tag":34,"props":101,"children":102},{},[103,105,110,112,117,119,124],{"type":31,"value":104},"深圳市注册公司还会有 ",{"type":17,"tag":45,"props":106,"children":107},{},[108],{"type":31,"value":109},"实审",{"type":31,"value":111}," 环节，需要本人去政务大厅 ",{"type":17,"tag":45,"props":113,"children":114},{},[115],{"type":31,"value":116},"从严审查",{"type":31,"value":118},"。从字面意思上看好像很严的样子，向我这样的草台班子肯定会露馅。总之就是很烦，被深圳硬控 ",{"type":17,"tag":45,"props":120,"children":121},{},[122],{"type":31,"value":123},"三个星期",{"type":31,"value":125},"：",{"type":17,"tag":127,"props":128,"children":131},"text-timeline",{"date":129,"title":130},"2026-10-28 — 2026-11-13","公司注册记录",[132,145,191,214,225,236,247,258,269,280,297,308,319,345,362,373],{"type":17,"tag":133,"props":134,"children":139},"timeline-item",{"dateTime":135,"time":136,"title":137,"kind":138},"2026-10-28","10-28","提交注册申请","fact",[140],{"type":17,"tag":34,"props":141,"children":142},{},[143],{"type":31,"value":144},"提交深圳市江雪安全技术有限公司的注册申请。",{"type":17,"tag":133,"props":146,"children":152},{"dateTime":147,"time":148,"title":149,"kind":138,"status":150,"details-label":151},"2026-11-02","11-02","被抽到实审","blocked","查看不予登记通知原文",[153,164],{"type":17,"tag":34,"props":154,"children":155},{},[156,158,162],{"type":31,"value":157},"收到不予登记通知，需要预约到龙岗区政务服务中心进行 ",{"type":17,"tag":45,"props":159,"children":160},{},[161],{"type":31,"value":116},{"type":31,"value":163},"。",{"type":17,"tag":165,"props":166,"children":167},"template",{"v-slot:details":7},[168],{"type":17,"tag":84,"props":169,"children":170},{},[171,176,181,186],{"type":17,"tag":34,"props":172,"children":173},{},[174],{"type":31,"value":175},"您通过互联网提交的深圳市江雪安全技术有限公司，受理编号为：xxxxx 的内资公司设立登记登记申请业务，我局依法决定不予登记；原因如下：",{"type":17,"tag":34,"props":177,"children":178},{},[179],{"type":31,"value":180},"经审查，我局拟对该业务进行从严审查【需预约办理。预约途径：下载进入i深圳APP→办事预约→龙岗区→深圳市龙岗区政务服务中心→在线预约→商事登记审查】，请本次申请的经办人或法定代表人（负责人）携带以下资料：",{"type":17,"tag":34,"props":182,"children":183},{},[184],{"type":31,"value":185},"1、本人身份证原件；",{"type":17,"tag":34,"props":187,"children":188},{},[189],{"type":31,"value":190},"2、该商事主体的住所（经营场所）使用证明【注：场地证明材料包括但不限于：①房产证；②租赁凭证；③双方签订的房屋租赁合同（配合出租方产权证明或水电缴费清单使用，水电缴费清单的缴费人显示为商事主体、股东/投资人、法定代表人/负责人或房东均可）；④其他证明凭证（如村委、市场开办单位证明等），选择其一即可】在预约时间到龙岗区政务服务中心完成该笔业务的从严审查。",{"type":17,"tag":133,"props":192,"children":196},{"dateTime":193,"time":194,"title":195,"kind":138},"2026-11-02T20:39:00+08:00","11-02 20:39","预约现场实审",[197,209],{"type":17,"tag":34,"props":198,"children":199},{},[200,202,207],{"type":31,"value":201},"预约龙岗区政务服务中心，",{"type":17,"tag":45,"props":203,"children":204},{},[205],{"type":31,"value":206},"11 月 5 日",{"type":31,"value":208},"过去实审。",{"type":17,"tag":34,"props":210,"children":211},{},[212],{"type":31,"value":213},"（不要问为什么隔着两天，因为预约都满了，深圳有钱人真的是太多了。）",{"type":17,"tag":133,"props":215,"children":219},{"dateTime":216,"time":217,"title":218},"2026-11-03T07:50:00+08:00","11-03 07:50","从成都出发",[220],{"type":17,"tag":34,"props":221,"children":222},{},[223],{"type":31,"value":224},"乘坐四川航空，从成都天府机场 T2 出发。",{"type":17,"tag":133,"props":226,"children":230},{"dateTime":227,"time":228,"title":229},"2026-11-03T10:10:00+08:00","11-03 10:10","到达深圳",[231],{"type":17,"tag":34,"props":232,"children":233},{},[234],{"type":31,"value":235},"到达深圳宝安机场 T3。",{"type":17,"tag":133,"props":237,"children":241},{"dateTime":238,"time":239,"title":240},"2026-11-03T11:47:00+08:00","11-03 11:47","领取白本",[242],{"type":17,"tag":34,"props":243,"children":244},{},[245],{"type":31,"value":246},"到达大庆大厦，领取房屋租赁证明（白本）。",{"type":17,"tag":133,"props":248,"children":252},{"dateTime":249,"time":250,"title":251},"2026-11-03T12:22:00+08:00","11-03 12:22","见到父母",[253],{"type":17,"tag":34,"props":254,"children":255},{},[256],{"type":31,"value":257},"见到父母。",{"type":17,"tag":133,"props":259,"children":263},{"dateTime":260,"time":261,"title":262,"kind":138,"status":150},"2026-11-03T20:05:00+08:00","11-03 20:05","注册地址又要换了",[264],{"type":17,"tag":34,"props":265,"children":266},{},[267],{"type":31,"value":268},"代办公司说，工商领导联系物业，说挂靠地址太多了，要给我换一个。",{"type":17,"tag":133,"props":270,"children":274},{"dateTime":271,"time":272,"title":273,"kind":138},"2026-11-04","11-04 10 时","重新提交注册申请",[275],{"type":17,"tag":34,"props":276,"children":277},{},[278],{"type":31,"value":279},"重新提交注册申请。",{"type":17,"tag":133,"props":281,"children":285},{"dateTime":282,"time":283,"title":284,"kind":138,"status":150},"2026-11-05","11-05","继续被从严审查",[286],{"type":17,"tag":34,"props":287,"children":288},{},[289,291,296],{"type":31,"value":290},"继续被从严审查，在政务中心预约到了 ",{"type":17,"tag":45,"props":292,"children":293},{},[294],{"type":31,"value":295},"11 月 10 日",{"type":31,"value":163},{"type":17,"tag":133,"props":298,"children":302},{"dateTime":299,"time":300,"title":301,"kind":138},"2026-11-07","11-07","收到新的白本地址",[303],{"type":17,"tag":34,"props":304,"children":305},{},[306],{"type":31,"value":307},"收到新的白本地址。",{"type":17,"tag":133,"props":309,"children":313},{"dateTime":310,"time":311,"title":312},"2026-11-08","11-08","和网友面基",[314],{"type":17,"tag":34,"props":315,"children":316},{},[317],{"type":31,"value":318},"和网友面基。",{"type":17,"tag":133,"props":320,"children":325},{"dateTime":321,"time":322,"title":323,"kind":138,"status":324},"2026-11-10","11-10","现场实审通过","done",[326],{"type":17,"tag":34,"props":327,"children":328},{},[329,331,336,338,343],{"type":31,"value":330},"去龙岗区政务大厅实审，整个过程 ",{"type":17,"tag":45,"props":332,"children":333},{},[334],{"type":31,"value":335},"不到 20 分钟",{"type":31,"value":337},"。把身份证和白本交给打工人，再去免费复印两份给他，审核就通过了。\n工作人员让当天 ",{"type":17,"tag":45,"props":339,"children":340},{},[341],{"type":31,"value":342},"下午 6 点",{"type":31,"value":344},"重新提交申请。",{"type":17,"tag":133,"props":346,"children":350},{"dateTime":347,"time":348,"title":349,"kind":138,"status":324},"2026-11-11","11-11","注册完成",[351],{"type":17,"tag":34,"props":352,"children":353},{},[354,356,361],{"type":31,"value":355},"审核通过，公司注册完成，迫不及待地下载了 ",{"type":17,"tag":45,"props":357,"children":358},{},[359],{"type":31,"value":360},"电子营业执照",{"type":31,"value":163},{"type":17,"tag":133,"props":363,"children":367},{"dateTime":364,"time":365,"title":366,"kind":138,"status":324},"2026-11-13","11-13","拿到公章和营业执照，去惠州",[368],{"type":17,"tag":34,"props":369,"children":370},{},[371],{"type":31,"value":372},"拿到了公章和营业执照副本。",{"type":17,"tag":133,"props":374,"children":377},{"dateTime":364,"time":365,"title":375,"kind":138,"status":376},"预约对公开户","已预约",[378],{"type":17,"tag":34,"props":379,"children":380},{},[381],{"type":31,"value":382},"预约微众银行开立对公账户。银行上门核查是外包给顺丰的，但顺丰小哥不知道怎么弄要第二天等他的主管教他。同时一两个小时后银行开户经理跟我说今天微众银行发通告，不能异地拍照  已经提交了不知道有没有影响。（我盲猜肯定审核不通过，然后又被深圳硬控一周）",{"type":17,"tag":34,"props":384,"children":385},{},[386],{"type":31,"value":387},"整个过程最绷不住的就是微众银行的上门核验外包给了顺丰，然后顺丰分配的小哥根本不知道是什么，要联系领导。还有就是打车的时候明显能感觉到出租车司机是更希望走高速的，因为可以节约很多时间，原本 120 分钟的路程走告诉 60 分钟就可以了，完成了我这一单还可以去接另一单。",{"type":17,"tag":34,"props":389,"children":390},{},[391],{"type":31,"value":392},"在深圳和父母住的这几天真的是非常难受，首先是饮食习惯不同。然后住的又是城中村房间很小，我只能睡在客厅，还没有办公桌（这个是最重要的，只能在床上办公）但从家门走出来到惠州父母买的房子下，打开我的房间那一刻突然发现有父母拌嘴还是很幸福的。",{"type":17,"tag":34,"props":394,"children":395},{},[396],{"type":31,"value":397},"以前沉淀的时候在惠州住了三年，母亲常来惠州看望我，每次都是大包小包的。要知道深圳距离惠州要 60km，母亲就这样拿着非常大的包来惠州看看我最近过的怎么样。",{"type":17,"tag":34,"props":399,"children":400},{},[401],{"type":31,"value":402},"在成都住了一年之后，回到深圳，回到惠州的房子，已经一年没有居住了，打开房间的时候霉味扑面而来，母亲用透明塑料袋将房屋整个包裹着，为了霉菌不沾染家具、被褥。唤起了我的孝心，暗自确定等明年回来一定给他们带点好东西。",{"type":17,"tag":68,"props":404,"children":406},{"id":405},"icp-备案",[407],{"type":31,"value":408},"ICP 备案",{"type":17,"tag":34,"props":410,"children":411},{},[412,414,421,423,429,431],{"type":31,"value":413},"做 ICP 备案的时候，我原本在 cloudflare 中注册了 ",{"type":17,"tag":415,"props":416,"children":418},"code",{"className":417},[],[419],{"type":31,"value":420},"jiangxues.com",{"type":31,"value":422}," 也就是 jiangxue security 的简写。但备案需要转入国内的服务商，例如阿里云、腾讯云之类的，于是我又在阿里云注册了 ",{"type":17,"tag":415,"props":424,"children":426},{"className":425},[],[427],{"type":31,"value":428},"jiangxues.cn",{"type":31,"value":430}," 并且在一个辗转反侧的凌晨，我冲动消费用花呗分期购入了 ",{"type":17,"tag":415,"props":432,"children":434},{"className":433},[],[435],{"type":31,"value":436},"jiangxue.net",{"type":17,"tag":34,"props":438,"children":439},{},[440,442,448,450,456,458,464,466,472,473,479],{"type":31,"value":441},"虽然 ",{"type":17,"tag":415,"props":443,"children":445},{"className":444},[],[446],{"type":31,"value":447},".net",{"type":31,"value":449}," 没有 ",{"type":17,"tag":415,"props":451,"children":453},{"className":452},[],[454],{"type":31,"value":455},".com",{"type":31,"value":457}," 权重高，但毕竟是 Network 的缩写，而且貌似云基础设施都喜欢用这个后缀，所以我就不断的催眠自己说这个钱画得非常值，毕竟大公司都会花很多钱去买域名，例如什么 ",{"type":17,"tag":415,"props":459,"children":461},{"className":460},[],[462],{"type":31,"value":463},"dji.com",{"type":31,"value":465},"、",{"type":17,"tag":415,"props":467,"children":469},{"className":468},[],[470],{"type":31,"value":471},"mi.com",{"type":31,"value":465},{"type":17,"tag":415,"props":474,"children":476},{"className":475},[],[477],{"type":31,"value":478},"x.com",{"type":31,"value":480},"。于是我就拥有了：",{"type":31,"value":482},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":17,"tag":484,"props":485,"children":486},"table",{},[487,506],{"type":17,"tag":488,"props":489,"children":490},"thead",{},[491],{"type":17,"tag":492,"props":493,"children":4