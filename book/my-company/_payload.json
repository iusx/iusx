[{"data":1,"prerenderedAt":780},["Reactive",2],{"page-document:/book/my-company":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":738,"_id":739,"_source":740,"_file":741,"_extension":742,"sitemap":743,"head":745},"/book/my-company","book",false,"","我创建的第一家公司","My","2026","my-company/1.png","1,100",{"type":14,"children":15,"toc":729},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,33,39,52,57,62,67,73,78,83,92,100,126,409,414,419,424,429,435,463,507,509,585,606,611,617,661,673,678,686,698],{"type":17,"tag":26,"props":27,"children":29},"h1",{"id":28},"my-dream",[30],{"type":31,"value":32},"text","My dream",{"type":17,"tag":34,"props":35,"children":36},"p",{},[37],{"type":31,"value":38},"以前上小学和初中的时候一直想着创业，名字当初都想好了分别是 “芈极创新” ，和负责安全的 “江雪分析”。依稀记得当时是 2018 年,也不知道当初是怎么想的，几年过后我跟他们都闹掰了淡淡的忘了联系。",{"type":17,"tag":34,"props":40,"children":41},{},[42,44,50],{"type":31,"value":43},"当时觉得如果有一家公司会很帅，因为可以申请微信公众号以及微博的 ",{"type":17,"tag":45,"props":46,"children":47},"strong",{},[48],{"type":31,"value":49},"V",{"type":31,"value":51}," 认证。八年过后我成功注册了一家公司，并没有想象中的那么难也没有那么简单。我将公司选择在了深圳市，毕竟是大城市，也是我从小长大的地方。毕竟以后出门说公司是深圳市的，比什么其他城市的会听起来高级一点。",{"type":17,"tag":34,"props":53,"children":54},{},[55],{"type":31,"value":56},"也是时候到了，朋友找我开发东西每次都是他自己垫付自掏腰包。而我还嫌弃每次都是几十几百块的磨磨叽叽要求多，但终于某一天他跟我透露心声不如让我去注册公司，开一个对公账户，这样每次就可以有发票找领导报销了。",{"type":17,"tag":34,"props":58,"children":59},{},[60],{"type":31,"value":61},"于是我也就冲动消费注册了公司。现在想真的是误入了一个深坑里，什么地方都要钱。但我建议有玉玉症的可以注册公司体验一下被人需要的感觉。",{"type":17,"tag":34,"props":63,"children":64},{},[65],{"type":31,"value":66},"当公司注册的那一刹那，慕名而来的推销电话可以接到手软，而且都会以 x 总称呼，非常能满足虚荣心。比掏大几万去看心理医生还没有用，投入到公司里面起码还有资产，知识产权什么的。",{"type":17,"tag":68,"props":69,"children":71},"h2",{"id":70},"注册",[72],{"type":31,"value":70},{"type":17,"tag":34,"props":74,"children":75},{},[76],{"type":31,"value":77},"其实注册公司一直是免费的，在这一段经历中我也踩了很多坑。我找了朋友问问他们是怎么注册公司的，全部都统一口径说淘宝代办的。于是我就在淘宝找了一个看起来还行，但店铺设计看起来是椰树风格的代办公司。宣传海报上写的很厉害，但实际一查就会发现貌似很多都是外包出去的。",{"type":17,"tag":34,"props":79,"children":80},{},[81],{"type":31,"value":82},"例如注册地址太 low，而不是我想要的什么创业园，科技园，工业园之类的，而是一个百货大楼。但谁让代办公司给的价格便宜呢（貌似到物业公司手上才 400）。地址费用一年是 1800,报税什么的是 1200。",{"type":17,"tag":84,"props":85,"children":86},"blockquote",{},[87],{"type":17,"tag":34,"props":88,"children":89},{},[90],{"type":31,"value":91},"龙岗小规模公司 挂靠真实地址 挂靠费用1800/年，赠送注册+ 章\n挂靠地址有管家服务，可开对公账户，可代收信函快递，可配合工商税务银行核查",{"type":17,"tag":84,"props":93,"children":94},{},[95],{"type":17,"tag":34,"props":96,"children":97},{},[98],{"type":31,"value":99},"小规模 不开票记账报税：1200元/年\n包含税务报道+税种核定+月报季报年报+年度汇算清缴+财务报表+年度工商年报+账本+社保+一对一财税会计对接+财务管理咨询+合理筹划报税",{"type":17,"tag":34,"props":101,"children":102},{},[103,105,110,112,117,119,124],{"type":31,"value":104},"深圳市注册公司还会有 ",{"type":17,"tag":45,"props":106,"children":107},{},[108],{"type":31,"value":109},"实审",{"type":31,"value":111}," 环节，需要本人去政务大厅 ",{"type":17,"tag":45,"props":113,"children":114},{},[115],{"type":31,"value":116},"从严审查",{"type":31,"value":118},"。从字面意思上看好像很严的样子，向我这样的草台班子肯定会露馅。总之就是很烦，被深圳硬控 ",{"type":17,"tag":45,"props":120,"children":121},{},[122],{"type":31,"value":123},"三个星期",{"type":31,"value":125},"：",{"type":17,"tag":127,"props":128,"children":131},"text-timeline",{"date":129,"title":130},"2026-10-28 — 2026-11-14","公司注册记录",[132,350,367,378,388],{"type":17,"tag":133,"props":134,"children":136},"timeline-group",{"title":135},"注册申请与实审",[137,150,196,219,230,241,252,263,274,285,302,313,324],{"type":17,"tag":138,"props":139,"children":144},"timeline-item",{"dateTime":140,"time":141,"title":142,"kind":143},"2026-10-28","10-28","提交注册申请","fact",[145],{"type":17,"tag":34,"props":146,"children":147},{},[148],{"type":31,"value":149},"提交深圳市江雪安全技术有限公司的注册申请。",{"type":17,"tag":138,"props":151,"children":157},{"dateTime":152,"time":153,"title":154,"kind":143,"status":155,"details-label":156},"2026-11-02","11-02","被抽到实审","blocked","查看不予登记通知原文",[158,169],{"type":17,"tag":34,"props":159,"children":160},{},[161,163,167],{"type":31,"value":162},"收到不予登记通知，需要预约到龙岗区政务服务中心进行 ",{"type":17,"tag":45,"props":164,"children":165},{},[166],{"type":31,"value":116},{"type":31,"value":168},"。",{"type":17,"tag":170,"props":171,"children":172},"template",{"v-slot:details":7},[173],{"type":17,"tag":84,"props":174,"children":175},{},[176,181,186,191],{"type":17,"tag":34,"props":177,"children":178},{},[179],{"type":31,"value":180},"您通过互联网提交的深圳市江雪安全技术有限公司，受理编号为：xxxxx 的内资公司设立登记登记申请业务，我局依法决定不予登记；原因如下：",{"type":17,"tag":34,"props":182,"children":183},{},[184],{"type":31,"value":185},"经审查，我局拟对该业务进行从严审查【需预约办理。预约途径：下载进入i深圳APP→办事预约→龙岗区→深圳市龙岗区政务服务中心→在线预约→商事登记审查】，请本次申请的经办人或法定代表人（负责人）携带以下资料：",{"type":17,"tag":34,"props":187,"children":188},{},[189],{"type":31,"value":190},"1、本人身份证原件；",{"type":17,"tag":34,"props":192,"children":193},{},[194],{"type":31,"value":195},"2、该商事主体的住所（经营场所）使用证明【注：场地证明材料包括但不限于：①房产证；②租赁凭证；③双方签订的房屋租赁合同（配合出租方产权证明或水电缴费清单使用，水电缴费清单的缴费人显示为商事主体、股东/投资人、法定代表人/负责人或房东均可）；④其他证明凭证（如村委、市场开办单位证明等），选择其一即可】在预约时间到龙岗区政务服务中心完成该笔业务的从严审查。",{"type":17,"tag":138,"props":197,"children":201},{"dateTime":198,"time":199,"title":200,"kind":143},"2026-11-02T20:39:00+08:00","11-02 20:39","预约现场实审",[202,214],{"type":17,"tag":34,"props":203,"children":204},{},[205,207,212],{"type":31,"value":206},"预约龙岗区政务服务中心，",{"type":17,"tag":45,"props":208,"children":209},{},[210],{"type":31,"value":211},"11 月 5 日",{"type":31,"value":213},"过去实审。",{"type":17,"tag":34,"props":215,"children":216},{},[217],{"type":31,"value":218},"（不要问为什么隔着两天，因为预约都满了，深圳有钱人真的是太多了。）",{"type":17,"tag":138,"props":220,"children":224},{"dateTime":221,"time":222,"title":223},"2026-11-03T07:50:00+08:00","11-03 07:50","从成都出发",[225],{"type":17,"tag":34,"props":226,"children":227},{},[228],{"type":31,"value":229},"乘坐四川航空，从成都天府机场 T2 出发。",{"type":17,"tag":138,"props":231,"children":235},{"dateTime":232,"time":233,"title":234},"2026-11-03T10:10:00+08:00","11-03 10:10","到达深圳",[236],{"type":17,"tag":34,"props":237,"children":238},{},[239],{"type":31,"value":240},"到达深圳宝安机场 T3。",{"type":17,"tag":138,"props":242,"children":246},{"dateTime":243,"time":244,"title":245},"2026-11-03T11:47:00+08:00","11-03 11:47","领取白本",[247],{"type":17,"tag":34,"props":248,"children":249},{},[250],{"type":31,"value":251},"到达大庆大厦，领取房屋租赁证明（白本）。",{"type":17,"tag":138,"props":253,"children":257},{"dateTime":254,"time":255,"title":256},"2026-11-03T12:22:00+08:00","11-03 12:22","见到父母",[258],{"type":17,"tag":34,"props":259,"children":260},{},[261],{"type":31,"value":262},"见到父母。",{"type":17,"tag":138,"props":264,"children":268},{"dateTime":265,"time":266,"title":267,"kind":143,"status":155},"2026-11-03T20:05:00+08:00","11-03 20:05","注册地址又要换了",[269],{"type":17,"tag":34,"props":270,"children":271},{},[272],{"type":31,"value":273},"代办公司说，工商领导联系物业，说挂靠地址太多了，要给我换一个。",{"type":17,"tag":138,"props":275,"children":279},{"dateTime":276,"time":277,"title":278,"kind":143},"2026-11-04","11-04 10 时","重新提交注册申请",[280],{"type":17,"tag":34,"props":281,"children":282},{},[283],{"type":31,"value":284},"重新提交注册申请。",{"type":17,"tag":138,"props":286,"children":290},{"dateTime":287,"time":288,"title":289,"kind":143,"status":155},"2026-11-05","11-05","继续被从严审查",[291],{"type":17,"tag":34,"props":292,"children":293},{},[294,296,301],{"type":31,"value":295},"继续被从严审查，在政务中心预约到了 ",{"type":17,"tag":45,"props":297,"children":298},{},[299],{"type":31,"value":300},"11 月 10 日",{"type":31,"value":168},{"type":17,"tag":138,"props":303,"children":307},{"dateTime":304,"time":305,"title":306,"kind":143},"2026-11-07","11-07","收到新的白本地址",[308],{"type":17,"tag":34,"props":309,"children":310},{},[311],{"type":31,"value":312},"收到新的白本地址。",{"type":17,"tag":138,"props":314,"children":318},{"dateTime":315,"time":316,"title":317},"2026-11-08","11-08","和网友面基",[319],{"type":17,"tag":34,"props":320,"children":321},{},[322],{"type":31,"value":323},"和网友面基。",{"type":17,"tag":138,"props":325,"children":330},{"dateTime":326,"time":327,"title":328,"kind":143,"status":329},"2026-11-10","11-10","现场实审通过","done",[331],{"type":17,"tag":34,"props":332,"children":333},{},[334,336,341,343,348],{"type":31,"value":335},"去龙岗区政务大厅实审，整个过程 ",{"type":17,"tag":45,"props":337,"children":338},{},[339],{"type":31,"value":340},"不到 20 分钟",{"type":31,"value":342},"。把身份证和白本交给打工人，再去免费复印两份给他，审核就通过了。\n工作人员让当天 ",{"type":17,"tag":45,"props":344,"children":345},{},[346],{"type":31,"value":347},"下午 6 点",{"type":31,"value":349},"重新提交申请。",{"type":17,"tag":138,"props":351,"children":355},{"dateTime":352,"time":353,"title":354,"kind":143,"status":329},"2026-11-11","11-11","注册完成",[356],{"type":17,"tag":34,"props":357,"children":358},{},[359,361,366],{"type":31,"value":360},"审核通过，公司注册完成，迫不及待地下载了 ",{"type":17,"tag":45,"props":362,"children":363},{},[364],{"type":31,"value":365},"电子营业执照",{"type":31,"value":168},{"type":17,"tag":138,"props":368,"children":372},{"dateTime":369,"time":370,"title":371,"kind":143,"status":329},"2026-11-13","11-13","拿到公章和营业执照，去惠州",[373],{"type":17,"tag":34,"props":374,"children":375},{},[376],{"type":31,"value":377},"拿到了公章和营业执照副本。",{"type":17,"tag":138,"props":379,"children":382},{"dateTime":369,"time":370,"title":380,"kind":143,"status":381},"预约对公开户","已预约",[383],{"type":17,"tag":34,"props":384,"children":385},{},[386],{"type":31,"value":387},"预约微众银行开立对公账户。银行上门核查是外包给顺丰的，但顺丰小哥不知道怎么弄要第二天等他的主管教他。同时一两个小时后银行开户经理跟我说今天微众银行发通告，不能异地拍照  已经提交了不知道有没有影响。（我盲猜肯定审核不通过，然后又被深圳硬控一周）",{"type":17,"tag":138,"props":389,"children":394},{"dateTime":390,"time":391,"title":392,"kind":143,"status":393},"2026-11-14","11-14","顺丰上门拍照","拍照",[395],{"type":17,"tag":34,"props":396,"children":397},{},[398,400,404,407],{"type":31,"value":399},"整个过程都是蚌埠住了，顺丰小哥和我基本上都不知道怎么拍，提交了就会被退回说什么门牌号二维码。但惠州又不是深圳，每个房间的二维码是没有的，只有门牌号。问了物业，物业也不知道。\n",{"type":17,"tag":401,"props":402,"children":403},"br",{},[],{"type":17,"tag":401,"props":405,"children":406},{},[],{"type":31,"value":408},"\n最后顺丰小哥拍了大楼号码就审核通过了，过了一个小时对公账户就开好了，之后我跟银行开户一样转了一块钱。银行经理给我发了个笑哭的表情，说被封了不要找他。之后我才明白对公账户和个人账户不一样，最好是整数，大几百而不是几块钱的小额支付。然后我转了 1400 到对公账户里面当作投资款。",{"type":17,"tag":34,"props":410,"children":411},{},[412],{"type":31,"value":413},"整个过程最绷不住的就是微众银行的上门核验外包给了顺丰，然后顺丰分配的小哥根本不知道是什么，要联系领导。还有就是打车的时候明显能感觉到出租车司机是更希望走高速的，因为可以节约很多时间，原本 120 分钟的路程走告诉 60 分钟就可以了，完成了我这一单还可以去接另一单。",{"type":17,"tag":34,"props":415,"children":416},{},[417],{"type":31,"value":418},"在深圳和父母住的这几天真的是非常难受，首先是饮食习惯不同。然后住的又是城中村房间很小，我只能睡在客厅，还没有办公桌（这个是最重要的，只能在床上办公）但从家门走出来到惠州父母买的房子下，打开我的房间那一刻突然发现有父母拌嘴还是很幸福的。",{"type":17,"tag":34,"props":420,"children":421},{},[422],{"type":31,"value":423},"以前沉淀的时候在惠州住了三年，母亲常来惠州看望我，每次都是大包小包的。要知道深圳距离惠州要 60km，母亲就这样拿着非常大的包来惠州看看我最近过的怎么样。",{"type":17,"tag":34,"props":425,"children":426},{},[427],{"type":31,"value":428},"在成都住了一年之后，回到深圳，回到惠州的房子，已经一年没有居住了，打开房间的时候霉味扑面而来，母亲用透明塑料袋将房屋整个包裹着，为了霉菌不沾染家具、被褥。唤起了我的孝心，暗自确定等明年回来一定给他们带点好东西。",{"type":17,"tag":68,"props":430,"children":432},{"id":431},"icp-备案",[433],{"type":31,"value":434},"ICP 备案",{"type":17,"tag":34,"props":436,"children":437},{},[438,440,447,449,455,457],{"type":31,"value":439},"做 ICP 备案的时候，我原本在 cloudflare 中注册了 ",{"type":17,"tag":441,"props":442,"children":444},"code",{"className":443},[],[445],{"type":31,"value":446},"jiangxues.com",{"type":31,"value":448}," 也就是 jiangxue security 的简写。但备案需要转入国内的服务商，例如阿里云、腾讯云之类的，于是我又在阿里云注册了 ",{"type":17,"tag":441,"props":450,"children":452},{"className":451},[],[453],{"type":31,"value":454},"jiangxues.cn",{"type":31,"value":456}," 并且在一个辗转反侧的凌晨，我冲动消费用花呗分期购入了 ",{"type":17,"tag":441,"props":458,"children":460},{"className":459},[],[461],{"type":31,"value":462},"jiangxue.net",{"type":17,"tag":34,"props":464,"children":465},{},[466,468,474,476,482,484,490,492,498,499,505],{"type":31,"value":467},"虽然 ",{"type":17,"tag":441,"props":469,"children":471},{"className":470},[],[472],{"type":31,"value":473},".net",{"type":31,"value":475}," 没有 ",{"type":17,"tag":441,"props":477,"children":479},{"className":478},[],[480],{"type":31,"value":481},".com",{"type":31,"value":483}," 权重高，但毕竟是 Network 的缩写，而且貌似云基础设施都喜欢用这个后缀，所以我就不断的催眠自己说这个钱画得非常值，毕竟大公司都会花很多钱去买域名，例如什么 ",{"type":17,"tag":441,"props":485,"children":487},{"className":486},[],[488],{"type":31,"value":489},"dji.com",{"type":31,"value":491},"、",{"type":17,"tag":441,"props":493,"children":495},{"className":494},[],[496],{"type":31,"value":497},"mi.com",{"type":31,"value":491},{"type":17,"tag":441,"props":500,"children":502},{"className":501},[],[503],{"type":31,"value":504},"x.com",{"type":31,"value":506},"。于是我就拥有了：",{"type":31,"value":508},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":17,"tag":510,"props":511,"children":512},"table",{},[513,532],{"type":17,"tag":514,"props":515,"children":516},"thead",{},[517],{"type":17,"tag":518,"props":519,"children":520},"tr",{},[521,527],{"type":17,"tag":522,"props":523,"children":524},"th",{},[525],{"type":31,"value":526},"Domain name",{"type":17,"tag":522,"props":528,"children":529},{},[530],{"type":31,"value":531},"Register time",{"type":17,"tag":533,"props":534,"children":535},"tbody",{},[536,550,562,574],{"type":17,"tag":518,"props":537,"children":538},{},[539,545],{"type":17,"tag":540,"props":541,"children":542},"td",{},[543],{"type":31,"value":544},"jiangxue.org",{"type":17,"tag":540,"props":546,"children":547},{},[548],{"type":31,"value":549},"2022-05-31",{"type":17,"tag":518,"props":551,"children":552},{},[553,557],{"type":17,"tag":540,"props":554,"children":555},{},[556],{"type":31,"value":462},{"type":17,"tag":540,"props":558,"children":559},{},[560],{"type":31,"value":561},"2026-11-12",{"type":17,"tag":518,"props":563,"children":564},{},[565,569],{"type":17,"tag":540,"props":566,"children":567},{},[568],{"type":31,"value":446},{"type":17,"tag":540,"props":570,"children":571},{},[572],{"type":31,"value":573},"2026-10-25",{"type":17,"tag":518,"props":575,"children":576},{},[577,581],{"type":17,"tag":540,"props":578,"children":579},{},[580],{"type":31,"value":454},{"type":17,"tag":540,"props":582,"children":583},{},[584],{"type":31,"value":352},{"type":17,"tag":34,"props":586,"children":587},{},[588,590,596,598,604],{"type":31,"value":589},"我打算将 ",{"type":17,"tag":441,"props":591,"children":593},{"className":592},[],[594],{"type":31,"value":595},"jiangxues",{"type":31,"value":597}," 这个不续费，毕竟我已经有了 ",{"type":17,"tag":441,"props":599,"children":601},{"className":600},[],[602],{"type":31,"value":603},"jiangxue",{"type":31,"value":605},"。说起来也很好笑。在初中和小学的时候非常迷恋什么黑客联盟，红客联盟。并拜了红客联盟的群管理员",{"type":17,"tag":68,"props":607,"children":609},{"id":608},"商标",[610],{"type":31,"value":608},{"type":17,"tag":612,"props":613,"children":615},"h3",{"id":614},"被注册了",[616],{"type":31,"value":614},{"type":17,"tag":34,"props":618,"children":619},{},[620,622,627,629,633,635,640,642,651,653,659],{"type":31,"value":621},"非常遗憾的是我并没有取得 ",{"type":17,"tag":45,"props":623,"children":624},{},[625],{"type":31,"value":626},"江雪",{"type":31,"value":628}," 的商标，尽管我们在 2018 年就开始用 ",{"type":17,"tag":45,"props":630,"children":631},{},[632],{"type":31,"value":626},{"type":31,"value":634},"了。甚至 2019 年的时候还以 ",{"type":17,"tag":45,"props":636,"children":637},{},[638],{"type":31,"value":639},"JIANGXUE",{"type":31,"value":641}," ",{"type":17,"tag":643,"props":644,"children":648},"a",{"href":645,"rel":646},"https://ctftime.org/team/87624/",[647],"nofollow",[649],{"type":31,"value":650},"参加过某个 CTF 比赛",{"type":31,"value":652},"，并且在 2018 年还注册了 ",{"type":17,"tag":441,"props":654,"children":656},{"className":655},[],[657],{"type":31,"value":658},"jiangxue.org.cn",{"type":31,"value":660}," (然后没续费被人注册了）。",{"type":17,"tag":34,"props":662,"children":663},{},[664,666,671],{"type":31,"value":665},"其实我当初就应该以个人名义申请注册 ",{"type":17,"tag":441,"props":667,"children":669},{"className":668},[],[670],{"type":31,"value":626},{"type":31,"value":672}," 商标。巧合的是另外几家公司也是在这一段时间内注册的。而且还有一家是高新技术企业。一看就很有实力很有钱，而我只是一个空壳公司，甚至业务和产品都没有想好怎么做。",{"type":17,"tag":34,"props":674,"children":675},{},[676],{"type":31,"value":677},"于是我开始焦虑。其他取得了江雪商标的会不会来控诉我。在此期间我想了很多种方案，例如换个名字。或者友好协商，毕竟其他几家江雪他们连 website 都没有，而且审美很 low（虽然他们赚了很多钱），或许我可以提供技术服务让他们授权给我使用，毕竟我做的是江雪安全，他们做的是其他业务。",{"type":17,"tag":84,"props":679,"children":680},{},[681],{"type":17,"tag":34,"props":682,"children":683},{},[684],{"type":31,"value":685},"不过像我这样的悲观主义者，预测几年后这几家就会以不正当竞争和商标起诉我，狠狠的爆一波金币。属鼠我啊，距离失信被执行人又近了一步。",{"type":17,"tag":34,"props":687,"children":688},{},[689,691,696],{"type":31,"value":690},"最后无奈我注册了 ",{"type":17,"tag":45,"props":692,"children":693},{},[694],{"type":31,"value":695},"洚雪 Jiàng xuě",{"type":31,"value":697}," 商标，并且以后以洚雪这个名字进行运营（虽然公司名还是江雪）。有趣的是在公众号认证的时候，知道创宇的那个审核还跟我确认：“您公司名是江雪，但服务号名字是洚雪，是不是打错了”，我跟对方说：“是江雪商标被注册了，我就注册了洚雪商标，所以叫洚雪”，感觉对方也是蚌埠住了。",{"type":17,"tag":34,"props":699,"children":700},{},[701,703,708,710,715,717,722,724],{"type":31,"value":702},"Logo 设计的时候我还是觉得以前 ",{"type":17,"tag":45,"props":704,"children":705},{},[706],{"type":31,"value":707},"JIANGXUE 江雪",{"type":31,"value":709}," logo 挺好看的，书法+english 非常的 very good。还记得这个书法完整的是 ",{"type":17,"tag":45,"props":711,"children":712},{},[713],{"type":31,"value":714},"江雪分析",{"type":31,"value":716},"，是在 2018 年由岱岳先生写的。现在新的 Logo 我是融合了雪花、氵（水字旁）、盾牌（也可以是 Cyber) 组成的。但我提前预测商标不会注册下来，因为这个太简洁了。但缩小之后 ",{"type":17,"tag":45,"props":718,"children":719},{},[720],{"type":31,"value":721},"洚雪 JiangXue",{"type":31,"value":723}," 容易被堪称 ",{"type":17,"tag":45,"props":725,"children":726},{},[727],{"type":31,"value":728},"泽雪 ZeXue",{"title":7,"searchDepth":730,"depth":730,"links":731},2,[732,733,734],{"id":70,"depth":730,"text":70},{"id":431,"depth":730,"text":434},{"id":608,"depth":730,"text":608,"children":735},[736],{"id":614,"depth":737,"text":614},3,"markdown","content:book:my-company.md","content","book/my-company.md","md",{"loc":744},"https://m.ritsu.jiangxue.org/book/my-company",{"script":746,"meta":754},[747],{"id":748,"type":749,"processTemplateParams":750,"innerHTML":751,"tagPosition":752,"tagPriority":753},"nuxt-og-image-overrides","application/json",true,"[{\"title\":1,\"excerpt\":-1,\"component\":2},\"我创建的第一家公司\",\"OgImageCustom\"]","bodyClose",30,[755,758,761,764,767,769,772,774,776,778],{"property":756,"content":757},"og:image","/__og-image__/static/book/my-company/og.png",{"property":759,"content":760},"og:image:width",1200,{"property":762,"content":763},"og:image:height",600,{"property":765,"content":766},"og:image:type","image/png",{"property":768},"og:image:alt",{"name":770,"content":771},"twitter:card","summary_large_image",{"name":773,"content":757},"twitter:image:src",{"name":775,"content":760},"twitter:image:width",{"name":777,"content":763},"twitter:image:height",{"name":779},"twitter:image:alt",1795812857661]