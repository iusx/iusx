[{"data":1,"prerenderedAt":506},["Reactive",2],{"content-query-zGnUv258M4":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":467,"_id":468,"_source":469,"_file":470,"_extension":471,"head":472},"/book/spine-2d","book",false,"","Spine 2D","My","2025","spine/1.png","100,100",{"type":14,"children":15,"toc":460},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,30,37,72,77,82,87,92,97,112,117,121,130,134,139,180,188,191,195,202,213,227,233,247,252,275,278,286,290,304,309,323,328,387,441,446],{"type":17,"tag":26,"props":27,"children":29},"text-title",{":t":28},"为什么是 Spine 2D",[],{"type":17,"tag":31,"props":32,"children":33},"p",{},[34],{"type":35,"value":36},"text","市面上同类型的产品有很多，例如 Live 2D、Pixelover、Rive 甚至是 Loongbones。有些效果 Adobe 的 AE 都可以做。但我为什么选择 Spine 2D 呢？无论如何，我看一个产品的角度是很片面的。我会从以下几点看待一个产品的实力：",{"type":17,"tag":38,"props":39,"children":40},"ol",{},[41,47,52,57,62,67],{"type":17,"tag":42,"props":43,"children":44},"li",{},[45],{"type":35,"value":46},"官网设计",{"type":17,"tag":42,"props":48,"children":49},{},[50],{"type":35,"value":51},"公司 Logo",{"type":17,"tag":42,"props":53,"children":54},{},[55],{"type":35,"value":56},"宣传物料",{"type":17,"tag":42,"props":58,"children":59},{},[60],{"type":35,"value":61},"产品打磨程度",{"type":17,"tag":42,"props":63,"children":64},{},[65],{"type":35,"value":66},"定价",{"type":17,"tag":42,"props":68,"children":69},{},[70],{"type":35,"value":71},"功能",{"type":17,"tag":31,"props":73,"children":74},{},[75],{"type":35,"value":76},"一般的情况下，我会为设计买单。那么自然淘汰掉了 Loongbones。但根据产品的打磨程度来说，我认为 Spine 2D 是无可厚非的。三年前我有幸接触过 Spine 2D，我甚至没有学过，打开界面的那一刻。我就知道如何操作，如何做出交互、动画，骨骼的绑定。那么自然而然的，Live 2D 和 Spine 2D 会进入到我的决赛圈。",{"type":17,"tag":31,"props":78,"children":79},{},[80],{"type":35,"value":81},"之所以最后选择了 Spine 2D，更多的是它的 runtime 以及买断的定价、产品的打磨和稳定的 Team。虽然官网不比 Live 2D 的那么商业化，显得很「技术流」。但在游戏领域积攒了很多的口碑（在 YT 和 A 站上看到了很多大佬，🇰🇷 动画真的没的说），以及 4.2 带来的物理效果无非让 Spine 2D 上了一个台阶。无论是生态上、还是定价以及产品的打磨程度。",{"type":17,"tag":31,"props":83,"children":84},{},[85],{"type":35,"value":86},"Rive 很不错，都是很新的产品链生态，例如 Figma to Rive，而 Spine 还是 PS to Spine。Rive 的整个官网和宣发物料也很用心，特别是大量的案例和 Runtime 展示，而 Spine 有，但是很低调（官网和宣发都很低调，不如 Live 2D 和 Rive 的包装，但产品打磨的很好。）",{"type":17,"tag":31,"props":88,"children":89},{},[90],{"type":35,"value":91},"但我最后还是选择 Spine 2D（用户体验很好，还是买断制，runtime 也比较用心，虽然不是特别新，但生态和社区还是有点活力的）",{"type":17,"tag":31,"props":93,"children":94},{},[95],{"type":35,"value":96},"我是愿意为 Spine 2D 付费的。因为我可以做游戏素材，做动画、利用 runtime 做交互甚至是 GAME，可以接触和学习到 U3D\\UE、Godot 方面的技术栈。(虽然看起来是 49 年入国军，但当一个消磨时间的爱好也挺好的，会感觉时间过的很快，在没意思的时候还可以做一些鬼畜的表情取悦自己。)",{"type":17,"tag":98,"props":99,"children":101},"text-space",{"type":100},"tip",[102,107],{"type":17,"tag":31,"props":103,"children":104},{},[105],{"type":35,"value":106},"不过 Pixelover 好像没有 runtime 只能做动画，但 2D 和 3D 的结合还是很有趣的。",{"type":17,"tag":31,"props":108,"children":109},{},[110],{"type":35,"value":111},"(2025-6-22 已经买了 Pixelover，看大佬说这个是转成完美像素风图片的，然后还可以做动画，骨骼甚至是 3D，唯一缺点就是有点卡)",{"type":17,"tag":31,"props":113,"children":114},{},[115],{"type":35,"value":116},"之后如果有机会，我会选择购买并体验下 Pixelover，感觉潜力也是很大的）但像素类型貌似很深受某些公司的喜欢，因为 AI 生成的像素风格会天然的有遮瑕效果，并且规避画师讨伐的风险。",{"type":17,"tag":118,"props":119,"children":120},"hr",{},[],{"type":17,"tag":122,"props":123,"children":127},"h1",{"id":124,"data-toc-marker":125,"data-toc-count":126,"aria-hidden":125},"runtime-1","true","1",[128],{"type":35,"value":129},"runtime 1",{"type":17,"tag":26,"props":131,"children":133},{"t":132},"Spine 2D runtime",[],{"type":17,"tag":31,"props":135,"children":136},{},[137],{"type":35,"value":138},"在此之前我们需要阅读下一些文档（Spine 2D 本地化做的挺好的，有很多 Lang。）",{"type":17,"tag":38,"props":140,"children":141},{},[142,156,168],{"type":17,"tag":42,"props":143,"children":144},{},[145,154],{"type":17,"tag":146,"props":147,"children":151},"a",{"href":148,"rel":149},"https://zh.esotericsoftware.com/spine-skeleton-viewer#Skeleton-Viewer",[150],"nofollow",[152],{"type":35,"value":153},"Skeleton Viewer",{"type":35,"value":155},": 测试从Spine导出的skeleton数据",{"type":17,"tag":42,"props":157,"children":158},{},[159,166],{"type":17,"tag":146,"props":160,"children":163},{"href":161,"rel":162},"https://zh.esotericsoftware.com/spine-json-format#JSON-%E5%AF%BC%E5%87%BA%E6%96%87%E4%BB%B6%E6%A0%BC%E5%BC%8F",[150],[164],{"type":35,"value":165},"JSON 导出文件格式",{"type":35,"value":167},":  Spine 2D 导出后的 Json 数据格式和介绍",{"type":17,"tag":42,"props":169,"children":170},{},[171,178],{"type":17,"tag":146,"props":172,"children":175},{"href":173,"rel":174},"https://github.com/EsotericSoftware/spine-runtimes",[150],[176],{"type":35,"value":177},"spine-runtimes examples",{"type":35,"value":179},": 一些 runtime 例子和 README。",{"type":17,"tag":98,"props":181,"children":182},{"type":100},[183],{"type":17,"tag":31,"props":184,"children":185},{},[186],{"type":35,"value":187},"有一说一 Spine 2D 的 Runtime 是真的丰富哇，注释和文档都很全，很快就能上手了。",{"type":17,"tag":118,"props":189,"children":190},{},[],{"type":17,"tag":26,"props":192,"children":194},{"t":193},"bilibili 小电视练习",[],{"type":17,"tag":196,"props":197,"children":199},"h2",{"id":198,"data-toc-marker":125,"data-toc-count":126,"aria-hidden":125},"bilibili-1",[200],{"type":35,"value":201},"bilibili 1",{"type":17,"tag":203,"props":204,"children":212},"iframe",{"width":205,"height":206,"src":207,"frameBorder":208,"allow":209,"referrerPolicy":210,"allowFullScreen":211},"100%",815,"https://stackblitz.com/edit/stackblitz-starters-b833pmbs?embed=1&file=index.html","0","accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share","strict-origin-when-cross-origin",true,[],{"type":17,"tag":31,"props":214,"children":215},{},[216,218,225],{"type":35,"value":217},"不要问为什么一个注释都没有，因为我用了 ",{"type":17,"tag":146,"props":219,"children":222},{"href":220,"rel":221},"https://github.com/jiangxue-analysis/nvim.comment-hide",[150],[223],{"type":35,"value":224},"nvim.comment-hide",{"type":35,"value":226}," 把注释全部去掉了，只有我自己可以看到（Spine 2d 的 runtime 注释是非常多的，很方便学习）之所以是拿 bilibili 的小电视来练习。并不是我多么喜欢，多么高强度在这个地方冲浪。",{"type":17,"tag":228,"props":229,"children":232},"img-tip",{"text":230,"url":231},"图 1 | Octocats 盯着你的输入框.gif（超级可爱","spine/img/1.gif",[],{"type":17,"tag":31,"props":234,"children":235},{},[236,238,245],{"type":35,"value":237},"更多的是看到了 Github 的 Octocats 交互设计，也就是 ",{"type":17,"tag":146,"props":239,"children":242},{"href":240,"rel":241},"https://github.com/copilot",[150],[243],{"type":35,"value":244},"copilot",{"type":35,"value":246}," 页面下那个小章鱼盯着输入框的交互。当时的我觉得非常震撼，觉得很厉害。于是我买 spine 2D 的出发点也是实现类似的效果。（庆幸的是我实现了）",{"type":17,"tag":228,"props":248,"children":251},{"text":249,"url":250},"图 2 | 在很多 blog 中很常见的看板娘","spine/img/2.gif",[],{"type":17,"tag":31,"props":253,"children":254},{},[255,257,264,266,273],{"type":35,"value":256},"当然还有类似的效果，例如 ",{"type":17,"tag":146,"props":258,"children":261},{"href":259,"rel":260},"https://github.com/stevenjoezhang/live2d-widget",[150],[262],{"type":35,"value":263},"看板娘",{"type":35,"value":265}," 放到 blog，角色的表情，目光跟随鼠标的效果。之前的我看到类似的效果只知道是如何实现的，而不知道是如何做的。经过这次 Spine 2D 的学习，我已经了解了这种效果是如何实现、如果做的。通过 Spine2d runtime 让 Ik 跟随鼠标，如果点击则播放 ",{"type":17,"tag":267,"props":268,"children":270},"code",{"className":269},[],[271],{"type":35,"value":272},"blink",{"type":35,"value":274}," 动画。",{"type":17,"tag":118,"props":276,"children":277},{},[],{"type":17,"tag":279,"props":280,"children":283},"h3",{"id":281,"data-toc-marker":125,"data-toc-count":282,"aria-hidden":125},"动捕-2","2",[284],{"type":35,"value":285},"动捕 2",{"type":17,"tag":26,"props":287,"children":289},{"t":288},"bilibili 小电视动捕",[],{"type":17,"tag":31,"props":291,"children":292},{},[293,295,302],{"type":35,"value":294},"有一说一上面的那个交互效果就已经回本了，但是我还想要做什么 VTB（没准以后公司倒闭了吃不上饭了还能 VTB 乞讨）利用 spine 的 runtime 是可以实现的，所以需要一个动捕的 package，有很多哇，我选择了 Google 的 ",{"type":17,"tag":146,"props":296,"children":299},{"href":297,"rel":298},"https://mediapipe-studio.webapps.google.com/demo/face_landmarker",[150],[300],{"type":35,"value":301},"mediapipe",{"type":35,"value":303},"（因为有很多 examples",{"type":17,"tag":228,"props":305,"children":308},{"text":306,"url":307},"图 3 | Apple Memoji（很掉帧，因为我压缩了\u003Cbr>WSJ NEWS:Memoji:From Old Japan to a Custom Apple Innovation","spine/img/3.gif",[],{"type":17,"tag":31,"props":310,"children":311},{},[312,314,321],{"type":35,"value":313},"动捕技术已经非常的流水线了，普通的 project 依赖于大厂的 api 就可以完成很好的动作效果，而且已经常见于生活当中。例如 Apple 的 ",{"type":17,"tag":146,"props":315,"children":318},{"href":316,"rel":317},"https://support.apple.com/zh-hk/111115",[150],[319],{"type":35,"value":320},"Memoji",{"type":35,"value":322}," 很常见。还是要摸一下类似的 demo 方便我以后做 VTB 的时候自己弄这些，所以就拿 bilibili 小电视练手好了。",{"type":17,"tag":228,"props":324,"children":327},{"text":325,"url":326},"图 4 | 就单个眨眼的效果（处于静态，就单独眨眼哇），可以看到 eyeBink 的数值的变动 SOURCE | \u003Ca href=\"https://codepen.io/mediapipe-preview/pen/OJBVQJm\">MediaPipe Face Landmarker Task for web\u003C/a>","spine/img/4.gif",[],{"type":17,"tag":31,"props":329,"children":330},{},[331,333,339,341,347,349,354,356,362,364,370,372,378,380,385],{"type":35,"value":332},"原理非常简单，还是 ",{"type":17,"tag":267,"props":334,"children":336},{"className":335},[],[337],{"type":35,"value":338},"look_main",{"type":35,"value":340}," skeleton 跟随鼠标移动，但利用的是 ",{"type":17,"tag":267,"props":342,"children":344},{"className":343},[],[345],{"type":35,"value":346},"window.electronAPI",{"type":35,"value":348},"，然后如果眨眼了就执行下 ",{"type":17,"tag":267,"props":350,"children":352},{"className":351},[],[353],{"type":35,"value":272},{"type":35,"value":355}," animationState。动捕方面，假设 ",{"type":17,"tag":267,"props":357,"children":359},{"className":358},[],[360],{"type":35,"value":361},"eyeBlinkLeft",{"type":35,"value":363}," 的数值正常是 ",{"type":17,"tag":267,"props":365,"children":367},{"className":366},[],[368],{"type":35,"value":369},"0.3",{"type":35,"value":371}," 那么如果是 ",{"type":17,"tag":267,"props":373,"children":375},{"className":374},[],[376],{"type":35,"value":377},"0.7",{"type":35,"value":379}," 那就是眨眼的动作，因此执行 ",{"type":17,"tag":267,"props":381,"children":383},{"className":382},[],[384],{"type":35,"value":272},{"type":35,"value":386},"。",{"type":17,"tag":98,"props":388,"children":389},{"type":100},[390,418],{"type":17,"tag":31,"props":391,"children":392},{},[393,395,400,402,408,410,416],{"type":35,"value":394},"我看有些 vtb 眨眼的时候一个眼睛眨一个眼睛没眨, 估计判断的数值比较多，比如 ",{"type":17,"tag":267,"props":396,"children":398},{"className":397},[],[399],{"type":35,"value":361},{"type":35,"value":401}," and ",{"type":17,"tag":267,"props":403,"children":405},{"className":404},[],[406],{"type":35,"value":407},"eyeBlinkRight",{"type":35,"value":409}," 甚至还有很多 ",{"type":17,"tag":267,"props":411,"children":413},{"className":412},[],[414],{"type":35,"value":415},"eyeLook",{"type":35,"value":417}," 的参数。",{"type":17,"tag":31,"props":419,"children":420},{},[421,423,430,432,439],{"type":35,"value":422},"之所以还是面向鼠标，单纯是我懒得写算法，会比较复杂（不适合我这种做个 demo 了解下流程的），选 APi 的时候太快了，应该选择 ",{"type":17,"tag":146,"props":424,"children":427},{"href":425,"rel":426},"https://mediapipe-studio.webapps.google.com/studio/demo/face_detector",[150],[428],{"type":35,"value":429}," Face Detection ",{"type":35,"value":431},", ",{"type":17,"tag":146,"props":433,"children":436},{"href":434,"rel":435},"https://mediapipe-studio.webapps.google.com/studio/demo/face_landmarker",[150],[437],{"type":35,"value":438}," Face Landmark Detection ",{"type":35,"value":440}," 太多参数了（",{"type":17,"tag":228,"props":442,"children":445},{"text":443,"url":444},"图 5 | 最终的实现效果，利用 mediapipe + spine 2d runtime + electron","spine/img/5.gif",[],{"type":17,"tag":31,"props":447,"children":448},{},[449,451,458],{"type":35,"value":450},"在众多的跨平台框架中，我选择了 ",{"type":17,"tag":146,"props":452,"children":455},{"href":453,"rel":454},"https://www.electronjs.org/",[150],[456],{"type":35,"value":457},"electronjs",{"type":35,"value":459},"。不是因为我多喜欢，也不是我之前用过，而是我以前在 Linux 上看到过他们的 Logo。给我留下了深刻的印象。当时并不知道这是什么，只知道 website 和 logo 还挺特别的。多年后我才知道这个是做什么的，算是弥补了童年的遗憾。",{"title":7,"searchDepth":461,"depth":461,"links":462},2,[463],{"id":198,"depth":461,"text":201,"children":464},[465],{"id":281,"depth":466,"text":285},3,"markdown","content:book:spine-2d.md","content","book/spine-2d.md","md",{"script":473,"meta":480},[474],{"id":475,"type":476,"processTemplateParams":211,"innerHTML":477,"tagPosition":478,"tagPriority":479},"nuxt-og-image-overrides","application/json","[{\"title\":1,\"excerpt\":-1,\"component\":2},\"Spine 2D\",\"OgImageCustom\"]","bodyClose",30,[481,484,487,490,493,495,498,500,502,504],{"property":482,"content":483},"og:image","/__og-image__/static/book/spine-2d/og.png",{"property":485,"content":486},"og:image:width",1200,{"property":488,"content":489},"og:image:height",600,{"property":491,"content":492},"og:image:type","image/png",{"property":494},"og:image:alt",{"name":496,"content":497},"twitter:card","summary_large_image",{"name":499,"content":483},"twitter:image:src",{"name":501,"content":486},"twitter:image:width",{"name":503,"content":489},"twitter:image:height",{"name":505},"twitter:image:alt",1792642118833]