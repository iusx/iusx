,"tag":157,"props":348,"children":349},{},[350],{"type":38,"value":351},"整理窗口",{"type":17,"tag":130,"props":353,"children":354},{},[355,360],{"type":17,"tag":157,"props":356,"children":357},{},[358],{"type":38,"value":359},"alt + w",{"type":17,"tag":157,"props":361,"children":362},{},[363],{"type":38,"value":364},"alt-w = 'fullscreen' 放大",{"type":17,"tag":41,"props":366,"children":367},{},[368,370,376],{"type":38,"value":369},"还是很容易就能上手的，例如可以自己配置 ",{"type":17,"tag":97,"props":371,"children":373},{"className":372},[],[374],{"type":38,"value":375},"alt",{"type":38,"value":377}," 快捷键，因为有很多，所有可以自定义：",{"type":17,"tag":379,"props":380,"children":384},"pre",{"className":381,"code":382,"language":383,"meta":7,"style":7},"language-toml shiki shiki-themes github-light github-dark","    alt-q = 'close'\n    alt-r = ['layout tiles', 'balance-sizes']\n    alt-z = 'layout tiles accordion'\n","toml",[385],{"type":17,"tag":97,"props":386,"children":387},{"__ignoreMap":7},[388,406,435],{"type":17,"tag":389,"props":390,"children":393},"span",{"class":391,"line":392},"line",1,[394,400],{"type":17,"tag":389,"props":395,"children":397},{"style":396},"--shiki-default:#3f3f3f;--shiki-dark-mode:#b3b3b3",[398],{"type":38,"value":399},"    alt-q = ",{"type":17,"tag":389,"props":401,"children":403},{"style":402},"--shiki-default:#656565;--shiki-dark-mode:#c7c7c7",[404],{"type":38,"value":405},"'close'\n",{"type":17,"tag":389,"props":407,"children":409},{"class":391,"line":408},2,[410,415,420,425,430],{"type":17,"tag":389,"props":411,"children":412},{"style":396},[413],{"type":38,"value":414},"    alt-r = [",{"type":17,"tag":389,"props":416,"children":417},{"style":402},[418],{"type":38,"value":419},"'layout tiles'",{"type":17,"tag":389,"props":421,"children":422},{"style":396},[423],{"type":38,"value":424},", ",{"type":17,"tag":389,"props":426,"children":427},{"style":402},[428],{"type":38,"value":429},"'balance-sizes'",{"type":17,"tag":389,"props":431,"children":432},{"style":396},[433],{"ty