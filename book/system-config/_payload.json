[{"data":1,"prerenderedAt":578},["Reactive",2],{"page-document:/book/system-config":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":536,"_id":537,"_source":538,"_file":539,"_extension":540,"sitemap":541,"head":543},"/book/system-config","book",false,"","System config","MY","2025","system-config/1.png","100,100",{"type":14,"children":15,"toc":534},"root",[16,528],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,30,40,75,91,105,109,119,121,219,244,247,253,257,271,285,290,292,365,378,449,454,459],{"type":17,"tag":26,"props":27,"children":29},"text-title",{"t":28},"Nix",[],{"type":17,"tag":31,"props":32,"children":36},"h1",{"id":33,"data-toc-marker":34,"data-toc-count":35,"aria-hidden":34},"为什么用-nix-2","true","2",[37],{"type":38,"value":39},"text","为什么用 Nix? 2",{"type":17,"tag":41,"props":42,"children":43},"p",{},[44,46,55,57,64,66,73],{"type":38,"value":45},"也是视奸 群u萌 看到的，了解了下发现是 2003 年就开始发布，至今已经 22 年了。（第一印象还以为是一个发行版，确实有，",{"type":17,"tag":47,"props":48,"children":52},"a",{"href":49,"rel":50},"https://nixos.org/",[51],"nofollow",[53],{"type":38,"value":54},"NixOS",{"type":38,"value":56},"）。再看看自己的系统环境确实有点乱，于是就有了重装系统的念头。新的系统毫不犹豫就用上了 Nix，不过我用的是 ",{"type":17,"tag":47,"props":58,"children":61},{"href":59,"rel":60},"https://github.com/DeterminateSystems/nix-installer",[51],[62],{"type":38,"value":63},"DeterminateSystems",{"type":38,"value":65}," 家的（好像是对 macOS 有优化？）个人感觉 Nix 貌似还挺成熟了，我看很多 community contributor 都是 ",{"type":17,"tag":47,"props":67,"children":70},{"href":68,"rel":69},"https://www.tweag.io/",[51],[71],{"type":38,"value":72},"tweag",{"type":38,"value":74}," 的员工？",{"type":17,"tag":76,"props":77,"children":80},"wise-info",{"by":78,"topic":79},"Wikipedia","Haskell Criticism",[81,86],{"type":17,"tag":41,"props":82,"children":83},{},[84],{"type":38,"value":85},"Haskell's build tool, Cabal, has historically been criticized for poorly handling multiple versions of the same library, a problem known as \"Cabal hell\". The Stackage server and Stack build tool were made in response to these criticisms. Cabal has since addressed this problem by borrowing ideas from a package manager named Nix, with the new approach becoming the default in 2019.",{"type":17,"tag":41,"props":87,"children":88},{},[89],{"type":38,"value":90},"Haskell 的构建工具 Cabal 历来因处理同一库的多个版本不力而受到批评，这个问题被称为“Cabal 地狱”。Stackage 服务器和 Stack 构建工具就是为了回应这些批评而制作的。 此后，Cabal 通过借鉴名为 Nix 的包管理器的想法来解决这个问题， 新方法在 2019 年成为默认方法。",{"type":17,"tag":41,"props":92,"children":93},{},[94,96,103],{"type":38,"value":95},"我发现了很多用 Haskell 的同时也会是 Nix 的使用者。甚至有些给 NixOS contributor 的也会是 Haskell contributor。一开始还不知道为什么，直到看到了 ",{"type":17,"tag":97,"props":98,"children":100},"code",{"className":99},[],[101],{"type":38,"value":102},"\"Cabal hell\"",{"type":38,"value":104}," 这个词才了解到了 Nix 和 Haskell 之间的渊源。",{"type":17,"tag":106,"props":107,"children":108},"hr",{},[],{"type":17,"tag":110,"props":111,"children":113},"text-space",{"type":112},"tip",[114],{"type":17,"tag":41,"props":115,"children":116},{},[117],{"type":38,"value":118},"记录一些自己常用的（用的时候可以翻翻",{"type":38,"value":120},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":17,"tag":122,"props":123,"children":124},"table",{},[125,149],{"type":17,"tag":126,"props":127,"children":128},"thead",{},[129],{"type":17,"tag":130,"props":131,"children":132},"tr",{},[133,139,144],{"type":17,"tag":134,"props":135,"children":136},"th",{},[137],{"type":38,"value":138},"command",{"type":17,"tag":134,"props":140,"children":141},{},[142],{"type":38,"value":143},"info",{"type":17,"tag":134,"props":145,"children":146},{},[147],{"type":38,"value":148},"e.g",{"type":17,"tag":150,"props":151,"children":152},"tbody",{},[153,178],{"type":17,"tag":130,"props":154,"children":155},{},[156,162,173],{"type":17,"tag":157,"props":158,"children":159},"td",{},[160],{"type":38,"value":161},"nix-shell",{"type":17,"tag":157,"props":163,"children":164},{},[165,167],{"type":38,"value":166},"创建一个隔离环境 或是 ",{"type":17,"tag":168,"props":169,"children":170},"strong",{},[171],{"type":38,"value":172},"以使用声明式配置文件创建可重现的 shell 环境",{"type":17,"tag":157,"props":174,"children":175},{},[176],{"type":38,"value":177},"nix-shell -p nodejs --run 'node -v'",{"type":17,"tag":130,"props":179,"children":180},{},[181,186,198],{"type":17,"tag":157,"props":182,"children":183},{},[184],{"type":38,"value":185},"nix-collect-garbage -d",{"type":17,"tag":157,"props":187,"children":188},{},[189,191,196],{"type":38,"value":190},"快速清理环境(但下次再进到 ",{"type":17,"tag":97,"props":192,"children":194},{"className":193},[],[195],{"type":38,"value":161},{"type":38,"value":197}," 环境下载有点慢)",{"type":17,"tag":157,"props":199,"children":200},{},[201,203,209,211,217],{"type":38,"value":202},"有点像是 ",{"type":17,"tag":97,"props":204,"children":206},{"className":205},[],[207],{"type":38,"value":208},"nix-env",{"type":38,"value":210}," & ",{"type":17,"tag":97,"props":212,"children":214},{"className":213},[],[215],{"type":38,"value":216},"nix-store",{"type":38,"value":218}," 的结合体哈哈好爽。",{"type":17,"tag":41,"props":220,"children":221},{},[222,224,229,231,236,238],{"type":38,"value":223},"不过对我来说 ",{"type":17,"tag":97,"props":225,"children":227},{"className":226},[],[228],{"type":38,"value":161},{"type":38,"value":230}," 貌似就很满足我的需求了。剩下的 ",{"type":17,"tag":97,"props":232,"children":234},{"className":233},[],[235],{"type":38,"value":208},{"type":38,"value":237},"（升级/卸载）只是 ​​在借阅记录（profile generation）中划掉某本书的名字​​，但书（包）仍然放在书架上 ",{"type":17,"tag":97,"props":239,"children":241},{"className":240},[],[242],{"type":38,"value":243},"（/nix/store）",{"type":17,"tag":106,"props":245,"children":246},{},[],{"type":17,"tag":31,"props":248,"children":250},{"id":249,"data-toc-marker":34,"data-toc-count":35,"aria-hidden":34},"aerospace-2",[251],{"type":38,"value":252},"aerospace 2",{"type":17,"tag":26,"props":254,"children":256},{"t":255},"aerospac