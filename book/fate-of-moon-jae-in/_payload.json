[{"data":1,"prerenderedAt":228},["Reactive",2],{"content-query-q6HPC0NBMK":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":7,"director":9,"time":10,"img":11,"plan":12,"body":13,"_type":188,"_id":189,"_source":190,"_file":191,"_extension":192,"head":193},"/book/fate-of-moon-jae-in","book",false,"","문재인의 운명","문재인","2024","fate-of-moon-jae-in/4.png","100,100",{"type":14,"children":15,"toc":185},"root",[16],{"type":17,"tag":18,"props":19,"children":24},"element","book-content",{":by":20,":img":21,":plan":22,":title":23},"director","img","plan","title",[25,35,40,46,51,56,61,86,102,111,116,122,160,164,171,175,180],{"type":17,"tag":26,"props":27,"children":31},"h1",{"id":28,"data-toc-marker":29,"data-toc-count":30,"aria-hidden":29},"理念-1","true","1",[32],{"type":33,"value":34},"text","理念 1",{"type":17,"tag":36,"props":37,"children":39},"text-title",{":t":38},"为什么看这本回忆录？",[],{"type":17,"tag":41,"props":42,"children":43},"p",{},[44],{"type":33,"value":45},"我承认很大一部分原因是因为文在寅颜值比较高，比较好奇他是怎么摆脱「青瓦台魔咒」清算的。对于韩国这个邻国，我并不太了解这个国家的文化和习俗，但韩剧还是很不错的，毕竟全部颜值在线同时还是实力派。我有留意过一些韩国大学的学生 CV，是非常注重形象管理的，将颜值即正义这个理念贯彻始终。",{"type":17,"tag":41,"props":47,"children":48},{},[49],{"type":33,"value":50},"如果要评价，我觉得文在寅是一个比较完美的总统，包装和营销的很不错，对比历任韩国总统算是很优秀的。在任内推行了共同投票，决定国家大小事务，比如最著名的 N 号房事件。让政府变得更加现代化，让群众可以线上投票参与治理。这在某些国家和地区婆罗门遍地的地方是很难推行的，而在韩国这个中文互联网以 “偷国” 蔑称的地方，却在文在寅任内推行起来了。",{"type":17,"tag":41,"props":52,"children":53},{},[54],{"type":33,"value":55},"我有一个习惯，就是想了解一个国家的时候。我会查看他们的政府官网，文在寅在任时的青瓦台总统官网，显得就很别具一格：",{"type":17,"tag":41,"props":57,"children":58},{},[59],{"type":33,"value":60},"以打开网站的第一版为例；",{"type":17,"tag":62,"props":63,"children":64},"ol",{},[65,71,76,81],{"type":17,"tag":66,"props":67,"children":68},"li",{},[69],{"type":33,"value":70},"有的政府官网，显示的是当权者的讲话和文件；",{"type":17,"tag":66,"props":72,"children":73},{},[74],{"type":33,"value":75},"有的政府官网，是一些便民的工具；",{"type":17,"tag":66,"props":77,"children":78},{},[79],{"type":33,"value":80},"有的政府官网，是国家的景色，旅游信息；",{"type":17,"tag":66,"props":82,"children":83},{},[84],{"type":33,"value":85},"有的政府官网，是一些数据，一些便民信息；",{"type":17,"tag":41,"props":87,"children":88},{},[89,91,100],{"type":33,"value":90},"打开 ",{"type":17,"tag":92,"props":93,"children":97},"a",{"href":94,"rel":95},"https://web.archive.org/web/20220319143845/https://www1.president.go.kr/petitions",[96],"nofollow",[98],{"type":33,"value":99},"https://www.president.go.kr/",{"type":33,"value":101}," 的时候，我比较在意 “국민소통 광장(国民沟通广场)” 这一板块，其中的内容就是投票几个比较多的话题，然后政府和青瓦台官员（各省厅长、青瓦台首席秘书、幕僚等）将做出回应。",{"type":17,"tag":103,"props":104,"children":105},"text-tip",{},[106],{"type":17,"tag":41,"props":107,"children":108},{},[109],{"type":33,"value":110},"\"정부 및 청와대 책임자(각 부처 및 기관의 장, 대통령 수석·비서관, 보좌관 등)가 답하겠습니다.\"",{"type":17,"tag":41,"props":112,"children":113},{},[114],{"type":33,"value":115},"当然，这个我们也有，诸如领导留言板，市长热线什么的。但面对下面这张图，会感觉本质上的区别。",{"type":17,"tag":117,"props":118,"children":121},"img-tip",{"text":119,"url":120},"🕯烛光集会：2016 年大韩民国反朴槿惠示威","fate-of-moon-jae-in/WechatIMG4.jpg",[],{"type":17,"tag":103,"props":123,"children":124},{},[125,130,135,140,145,150,155],{"type":17,"tag":41,"props":126,"children":127},{},[128],{"type":33,"value":129},"“总统第一次被弹劾，就是韩国历史上发生的事情，人民是伟大的，当把社会看成一个总体，是论乱的。人民对总统的需求不断增大，这正是年轻人的未来。",{"type":17,"tag":41,"props":131,"children":132},{},[133],{"type":33,"value":134},"这是我任期五年，我回去做公民，一刻都不能放松，来回匆忙的压力使得我们和人民永远清醒，有永不放弃那种自信和热情，它给你信心和勇气。",{"type":17,"tag":41,"props":136,"children":137},{},[138],{"type":33,"value":139},"五年来我们并肩作战的敌人，是时候完成或缺少，作为意识形态被永远铭记为前进的经验。",{"type":17,"tag":41,"props":141,"children":142},{},[143],{"type":33,"value":144},"希望公民，与此同时和我一起走出这段历史。",{"type":17,"tag":41,"props":146,"children":147},{},[148],{"type":33,"value":149},"我感谢迄今为止很多支持我的人，我不会忘记，很多事情都是在人民的帮助下所完成的，记住，在韩国有了新的开始，我会支持你的。",{"type":17,"tag":41,"props":151,"children":152},{},[153],{"type":33,"value":154},"和一起变老的妻子，回到南方乡村，我会像抑郁症一样生活的很好。”",{"type":17,"tag":41,"props":156,"children":157},{},[158],{"type":33,"value":159},"——文在寅",{"type":17,"tag":161,"props":162,"children":163},"hr",{},[],{"type":17,"tag":26,"props":165,"children":168},{"id":166,"data-toc-marker":29,"data-toc-count":167,"aria-hidden":29},"检察官-2","2",[169],{"type":33,"value":170},"检察官 2",{"type":17,"tag":36,"props":172,"children":174},{":t":173},"青瓦台魔咒",[],{"type":17,"tag":41,"props":176,"children":177},{},[178],{"type":33,"value":179},"看一个人从来不是他说了什么，而是他做了什么。韩国总统下台后就会遭到调查，很大一部分是韩国检察官的权利之高。如果你没问题，那就找你周边人的问题，朋友，亲戚，甚至是膝下儿女，总能发现一点蛛丝马迹。",{"type":17,"tag":41,"props":181,"children":182},{},[183],{"type":33,"value":184},"他最初想当法官。但因为青年时参与 “汉城之春” 被逮捕，所以只能成为律师，进入卢武铉的律所；最后两人成为一生挚友。两人在釜山期间，有两个字可以概述，那是一个违禁词。",{"title":7,"searchDepth":186,"depth":186,"links":187},2,[],"markdown","content:book:fate-of-moon-jae-in.md","content","book/fate-of-moon-jae-in.md","md",{"script":194,"meta":202},[195],{"id":196,"type":197,"processTemplateParams":198,"innerHTML":199,"tagPosition":200,"tagPriority":201},"nuxt-og-image-overrides","application/json",true,"[{\"title\":1,\"excerpt\":-1,\"component\":2},\"문재인의 운명\",\"OgImageCustom\"]","bodyClose",30,[203,206,209,212,215,217,220,222,224,226],{"property":204,"content":205},"og:image","/__og-image__/static/book/fate-of-moon-jae-in/og.png",{"property":207,"content":208},"og:image:width",1200,{"property":210,"content":211},"og:image:height",600,{"property":213,"content":214},"og:image:type","image/png",{"property":216},"og:image:alt",{"name":218,"content":219},"twitter:card","summary_large_image",{"name":221,"content":205},"twitter:image:src",{"name":223,"content":208},"twitter:image:width",{"name":225,"content":211},"twitter:image:height",{"name":227},"twitter:image:alt",1792669054924]